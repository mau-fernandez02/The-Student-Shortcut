---
import Layout from "../layouts/Layout.astro";
import Section1 from "../components/Intercambio/Section1.astro";
import Section2 from "../components/Intercambio/Section2.astro";
import Section3 from "../components/Intercambio/Section3.astro";
import Section4 from "../components/Intercambio/Section4.astro";
---

<!-- Irse de Intercambio -->
<Layout>
  <main>
    <Section1 />
    <Section2 />
    <Section3 />
    <Section4 />
  </main>
</Layout>

<style>
  main {
    /* Offset for fixed header */
    /* background: #ffffff; */
    background-image:
      url("/img/noise.png"),
      linear-gradient(180deg, #0cabe6 0%, #1f9cc9 55%, #005b97 100%);
    background-repeat: repeat;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
  }
</style>
