---
// src/pages/irse-intercambio.astro
import Layout from "../layouts/Layout.astro";
import Section1 from "../components/Intercambio/Section1.astro";
import Section2 from "../components/Intercambio/Section2.astro";
import Section3 from "../components/Intercambio/Section3.astro";
import Section4 from "../components/Intercambio/Section4.astro";
---

<!-- Irse de Intercambio -->
<Layout title="Irse de Intercambio | The Student Shortcut">
  <main class="exchange-page">
    <!-- Hero Intercambio con Video A y Nubes -->
    <Section1 />
    <!-- Perfil postulante con Video B -->
    <Section2 />
    <!-- Proceso / Pasos de Intercambio -->
    <Section3 />
    <!-- Razones de Intercambio con Video C, D, E -->
    <Section4 />
  </main>
</Layout>

<style>
  /* Requerimiento 3: Corregir el fondo degradado de la página de Intercambio */
  .exchange-page {
    min-height: calc(100vh - 75px);
    background-color: #005b97;
    background-image:
      url("/img/noise.png"),
      linear-gradient(180deg, #ffffff 0%, #caeafa 10%, #1e9cd7 28%, #117fb6 55%, #005b97 100%);
    background-repeat: repeat, no-repeat;
    background-size: auto, 100% 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    width: 100%;
    overflow: hidden;
  }
</style>
