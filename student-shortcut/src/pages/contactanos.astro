---
// src/pages/contactanos.astro
import Layout from '../layouts/Layout.astro';
import ContactoInfo from '../components/Contacto/ContactoInfo.astro';
---

<Layout title="Contáctanos | The Student Shortcut">
  <main class="contact-page">
    <section class="contact-page__content">
      <ContactoInfo />
    </section>
  </main>
</Layout>

<style>
  .contact-page {
    width: 100%;
    min-height: calc(100vh - 75px);
    padding-top: 100px;
    padding-bottom: 60px;
    background-color: #005b97;
    background-image:
      url("/img/noise.png"),
      linear-gradient(180deg, #1e9cd7 0%, #127eb5 48%, #005b97 100%);
    background-repeat: repeat, no-repeat;
    background-size: auto, 100% 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .contact-page__content {
    width: 100%;
  }

  @media (max-width: 860px) {
    .contact-page {
      padding-top: 85px;
    }
  }
</style>