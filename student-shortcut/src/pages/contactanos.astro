---
import Layout from "../layouts/Layout.astro";
---

<!-- Pagina: Contactanos -->
<Layout>
  <main>
    <div class="contact-container">
      <div class="contact-info">
        <h1>¡CONTÁCTANOS!</h1>
        <p>Numero telefonico: (+591 62553158)</p>
        <p>Correo electronico: [EMAIL_ADDRESS]</p>
        <p>Dirección: Los Pinos, Calle 4, N</p>
        <ul class="social-media">
          <li><img src="#svg" alt="" /> @Estudent-Shortcut.Bo</li>
          <li><img src="#svg" alt="" /> @Estudent-Shortcut.Bo</li>
          <li><img src="#svg" alt="" /> @Estudent-Shortcut.Bo</li>
          <li><img src="#svg" alt="" /> @Estudent-Shortcut.Bo</li>
        </ul>
      </div>
      <div class="contact-form">
        <div class="place-holder maps">
          <!-- Aquí va el widget de Google Maps -->
        </div>

        <!-- Modal -->
        <div class="modal" id="formModal">
          <div class="modal-content">
            <div class="modal-header">
              <h2>Contacta con nosotros</h2>
              <button class="close-btn" id="closeBtn">&times;</button>
            </div>
            <div class="form-container">
              <form action="/enviar-mensaje" method="POST">
                <div class="input-group">
                  <label for="name">Nombre:</label>
                  <input type="text" id="name" placeholder="Nombre" />
                </div>
                <div class="input-group">
                  <label for="email">Correo electronico:</label>
                  <input type="email" id="email" placeholder="Correo electronico" />
                </div>
                <div class="input-group">
                  <label for="message">Mensaje:</label>
                  <textarea id="message" placeholder="Mensaje"></textarea>
                </div>
                <div class="button-group">
                  <button type="submit">Enviar</button>
                  <button type="button" class="cancel-btn" id="cancelBtn">Cancelar</button>
                </div>
              </form>
            </div>
          </div>
        </div>

        <!-- Botón para abrir el formulario -->
        <div class="form-access">
          <p>Llena el formulario para enviarnos un mensaje.</p>
          <button id="openFormBtn">Abrir Formulario</button>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  main {
    background-image:
      url("/img/noise.png"),
      linear-gradient(180deg, #005b97 14%, #23b9f0 55%, #ffffff 100%);
    background-repeat: repeat;
    position: relative;
    height: 80vh;
  }
  .contact-container {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2rem;
    margin: 0rem auto;
   
    width: min(85%, 1100px);
  
    
  }
  .contact-info {
    padding: 2rem;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
    color: white;
  }
  .contact-info h1 {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 700;
    color: white;
  }
  .contact-info p {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: white;
  }
  .social-media {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1rem;
  }

  .contact-form {
    
    padding: 2rem;
    border-radius: 8px;
  }

  .place-holder.maps {
    width: 100%;
    height: 200px;
    background-color: #e0e0e0;
    border-radius: 8px;
    margin-bottom: 1rem;
  }

  /* Estilos del Modal */
  .modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    animation: fadeIn 0.3s ease-in;
  }

  .modal.active {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .modal-content {
    background-color: white;
    padding: 2rem;
    border-radius: 8px;
    width: 90%;
    max-width: 500px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    animation: slideIn 0.3s ease-out;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid #005b97;
    padding-bottom: 1rem;
  }

  .modal-header h2 {
    margin: 0;
    color: #005b97;
    font-size: 1.5rem;
  }

  .close-btn {
    background: none;
    border: none;
    font-size: 2rem;
    cursor: pointer;
    color: #005b97;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background-color 0.3s ease;
  }

  .close-btn:hover {
    background-color: #f0f0f0;
  }

  .form-container {
    padding: 0;
  }

  .contact-form form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .input-group label {
    font-weight: bold;
    color: #333;
  }

  .input-group input,
  .input-group textarea {
    padding: 0.75rem;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 1rem;
    font-family: inherit;
  }
  .input-group textarea {
  width: 100%;
  min-width: 450px;
  max-width: 650px;
  min-height: 150px;
  resize: none;
}

  .input-group input:focus,
  .input-group textarea:focus {
    outline: none;
    border-color: #23b9f0;
    box-shadow: 0 0 5px rgba(35, 185, 240, 0.5);
  }

  .button-group {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .button-group button {
    flex: 1;
    padding: 0.75rem;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    font-weight: bold;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .button-group button[type="submit"] {
    background-color: #23b9f0;
    color: white;
  }

  .button-group button[type="submit"]:hover {
    background-color: #005b97;
  }

  .cancel-btn {
    background-color: #e0e0e0;
    color: #333;
  }

  .cancel-btn:hover {
    background-color: #d0d0d0;
  }

  #openFormBtn {
    padding: 0.75rem 1.5rem;
    background-color: #005b97;
    color: white;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    font-weight: bold;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  #openFormBtn:hover {
    background-color: #23b9f0;
  }

  .form-access {
    text-align: center;
    margin-top: 1rem;
  }

  /* Animaciones */
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes slideIn {
    from {
      transform: translateY(-50px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
  @media (max-width: 900px) {
    .contact-container {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1rem;
    }
    .input-group textarea {
      min-width: 100%;
      max-width: 100%;
    }
  }
</style>

<script>
  // Obtener elementos del DOM
  const modal = document.getElementById("formModal");
  const openBtn = document.getElementById("openFormBtn");
  const closeBtn = document.getElementById("closeBtn");
  const cancelBtn = document.getElementById("cancelBtn");

  // Abrir modal
  openBtn.addEventListener("click", () => {
    modal.classList.add("active");
  });

  // Cerrar modal con el botón X
  closeBtn.addEventListener("click", () => {
    modal.classList.remove("active");
  });

  // Cerrar modal con el botón Cancelar
  cancelBtn.addEventListener("click", () => {
    modal.classList.remove("active");
  });

  // Cerrar modal cuando se hace clic fuera del modal-content
  window.addEventListener("click", (event) => {
    if (event.target === modal) {
      modal.classList.remove("active");
    }
  });
</script>