---
// src/pages/contactanos.astro

import Layout from '../layouts/Layout.astro';
import ContactoHero from '../components/Contacto/ContactoHero.astro';
import ContactoInfo from '../components/Contacto/ContactoInfo.astro';
import ContactoForm from '../components/Contacto/ContactoForm.astro';
---

<Layout title="Contáctanos - Intercambios">
  <main class="contact-page">
    <ContactoHero />

    <section class="contact-page__content">
      <div class="contact-page__container">
        <ContactoInfo />
        <ContactoForm />
      </div>
    </section>
  </main>
</Layout>

<style>
  .contact-page {
    width: 100%;
    min-height: 100vh;
    padding-bottom: 80px;
    background-image:
      url("/img/noise.png"),
      linear-gradient(180deg, #0cabe6 0%, #1f9cc9 55%, #005b97 100%);
  }

  .contact-page__content {
    width: 100%;
  }

  .contact-page__container {
    width: min(100%, 1050px);
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 2rem;
    align-items: stretch;
  }

  @media (max-width: 850px) {
    .contact-page__container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>