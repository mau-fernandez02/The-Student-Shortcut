---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
export const prerender = false;
---

<Layout title="The Student Shortcut - Intercambios Estudiantiles">
	<Header />

	<main>
		<!-- Placeholder section just to test scroll effect of navbar -->
		<section class="hero-section">
			<div class="container hero-grid">
				<!-- Columna Izquierda: Video 1:1 -->
				<div class="video-column">
					<!-- Atributos importantes: autoplay, loop y muted son obligatorios para que el video inicie solo sin requerir que el usuario haga clic -->
					<video autoplay loop muted playsinline class="hero-video">
						<source src="/media/Vid-00001.webm" type="video/mp4" />
						Tu navegador no soporta la reproducción de video.
					</video>
				</div>

				<!-- Columna Derecha: Textos y Botones -->
				<div class="text-column">
					<h1>
						Estudiar en el Extranjero...<br /> Nunca estuvo tan a tu alcance
					</h1>
					<p>
						Conquista tus habilidades en un nuevo país, nueva
						cultura, nuevo idioma.
					</p>
					<div class="cta-group">
						<a href="#programas" class="btn btn-primary"
							>Ver programas</a
						>
						<a href="#nosotros" class="btn btn-secondary"
							>Conocer más</a
						>
					</div>
				</div>
			</div>
		</section>

		<section class="sec2">
			<div class="container sec2-grid">
				<div class="text-sec2">
					<h1>
						Descubre tu Potencial, <br />
						<span class="text-style-2">¡Explora el Mundo!</span>
					</h1>
					<h2>
						Desafía tus Límites, Insertate en una cultura diferente
						y aprende
					</h2>
					<p>
						Si estás leyendo esto, es porque sueñas alto. Lo único
						que te falta, es despegar. <br />¿Qué pasaría si te digo
						que estamos aquí para ayudarte a hacerlo? <br />The
						Student Shortcut te ofrece una ayuda completa para
						realizar tu intercambio en el extranjero.
					</p>
				</div>
				<div class="image-sec2">
					<img
						src="https://www.gstatic.com/webp/gallery/1.jpg"
						alt="Imagen de prueba"
					/>
				</div>
			</div>
		</section>

		<section class="sec2">
			<div class="container tier-3-container">
				<div class="tier-3-subgrid">
					<!-- Fila 1 -->
					<div class="grid-item box-1">
						<video
							autoplay
							loop
							muted
							playsinline
							class="hero-video"
						>
							<source
								src="/media/Vid-00001.webm"
								type="video/mp4"
							/>
							Tu navegador no soporta la reproducción de video.
						</video>
					</div>
					<div class="grid-item box-2">
						<video
							autoplay
							loop
							muted
							playsinline
							class="hero-video"
						>
							<source
								src="/media/Vid-00001.webm"
								type="video/mp4"
							/>
							Tu navegador no soporta la reproducción de video.
						</video>
					</div>

					<!-- Fila 2 -->
					<div class="grid-item box-3">
						<video
							autoplay
							loop
							muted
							playsinline
							class="hero-video"
						>
							<source
								src="/media/Vid-00001.webm"
								type="video/mp4"
							/>
							Tu navegador no soporta la reproducción de video.
						</video>
					</div>
					<div class="grid-item box-4">
						<video
							autoplay
							loop
							muted
							playsinline
							class="hero-video"
						>
							<source
								src="/media/Vid-00001.webm"
								type="video/mp4"
							/>
							Tu navegador no soporta la reproducción de video.
						</video>
					</div>

					<!-- Fila 3 -->
					<div class="grid-item box-5">
						<video
							autoplay
							loop
							muted
							playsinline
							class="hero-video"
						>
							<source
								src="/media/Vid-00001.webm"
								type="video/mp4"
							/>
							Tu navegador no soporta la reproducción de video.
						</video>
					</div>
				</div>
				<div class="text-tier-3">
					<h1>
						¡Cualquier sueño es posible <br />si lo hacemos Juntos!
					</h1>
					<h2>
						Desafía tus Límites, Insertate en una cultura diferente
						y aprende
					</h2>
					<p>
						El equipo de The Student Shortcut te acompaña en todo el
						proceso para que puedes disfrutar de tu Experiencia de
						Intercambio.<br /> Te asesoramos a lo largo de tu postulación
						para asegurar la mejor compa tibilidad entre tú y tu destino.
						<br />Nosotros nos encargamos de encontrar la mejor
						familia anfitriona para ti.<br /> Te ayudamos con el idioma
						para que la transición sea más sencilla.<br /> Simplificamos
						la relación entre colegios locales y extranjeros para la vali
						dación de materias y notas
					</p>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	main {
		padding-top: 85px; /* Offset for fixed header */
		/* background: #ffffff; */
		background-image:
			url("/img/noise2.png"),
			linear-gradient(
				180deg,
				rgba(255, 255, 255, 1) 14%,
				rgba(31, 156, 201, 1) 55%,
				rgba(0, 91, 151, 1) 100%
			);
		background-repeat: repeat;
	}

	.hero-placeholder {
		min-height: calc(100vh - 80px);
		display: flex;
		align-items: center;
		background: radial-gradient(
			circle at 10% 20%,
			rgba(188, 223, 248, 0.4) 0%,
			rgba(248, 250, 252, 1) 90%
		);
		padding: 4rem 0;
	}

	.hero-content {
		max-width: 800px;
		text-align: center;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
	}

	.hero-content h1 {
		font-size: clamp(2.5rem, 5vw, 4rem);
		color: var(--color-brand-dark);
		line-height: 1.15;
	}

	.hero-content p {
		font-size: clamp(1.1rem, 2vw, 1.25rem);
		color: var(--text-muted);
		max-width: 600px;
	}

	.cta-group {
		display: flex;
		gap: 1rem;
		margin-top: 1rem;
	}

	/* Sistema de cuadrícula para las dos columnas */
	.hero-grid {
		display: grid;
		grid-template-columns: 1fr 1fr; /* Crea dos columnas del mismo tamaño */
		gap: 32px; /* Espacio entre el video y el texto */
		align-items: center; /* Centra el contenido verticalmente */
		padding: 60px 0;
	}

	/* --- Columna Izquierda (Video) --- */
	.video-column {
		width: 100%;
		aspect-ratio: 1 / 1; /* Esto fuerza la relación de aspecto cuadrada */
		border-radius: 10px; /* Opcional: bordes redondeados */
		overflow: hidden; /* Evita que el video se salga de los bordes redondeados */
	}

	.hero-video {
		width: 100%;
		height: 100%;
		object-fit: cover; /* Asegura que el video llene el cuadro 1:1 sin deformarse */
	}

	/* --- Columna Derecha (Texto y botones) --- */
	.text-column h1 {
		font-size: 55px;
		margin-bottom: 20px;
	}

	.text-column p {
		font-size: 1.2rem;
		margin-bottom: 30px;
		color: #555; /* Un gris oscuro para el texto, ajústalo a tu paleta */
	}

	/* Contenedor de los botones */
	.cta-group {
		display: flex;
		gap: 15px; /* Espacio entre los dos botones */
		flex-wrap: wrap; /* Si la pantalla es pequeña, el segundo botón pasa abajo automáticamente */
	}

	/* Segunda Seccion */
	.sec2-grid {
		display: grid;
		grid-template-columns: 1fr 1fr; /* Crea dos columnas del mismo tamaño */
		gap: 32px; /* Espacio entre el video y el texto */
		align-items: center; /* Centra el contenido verticalmente */
		padding: 60px 0;
	}
	.image-sec2 {
		width: 100%;
		aspect-ratio: 1 / 1; /* Esto fuerza la relación de aspecto cuadrada */
		border-radius: 10px; /* Opcional: bordes redondeados */
		overflow: hidden;
	}
	.image-sec2 img {
		width: 100%;
		height: 100%;
		object-fit: cover; /* Asegura que el video llene el cuadro 1:1 sin deformarse */
	}

	.text-sec2 {
		display: flex;
		flex-direction: column;
		gap: 20px;
		align-items: center;
		text-align: center;
		line-height: 1.6;
		color: white;
		text-shadow: 1.5px 1.5px 0px rgba(0, 0, 0, 0.2);
	}
	.text-sec2 h1 {
		font-size: 40px;
		color: white;
	}
	.text-style-2 {
		font-size: 55px;
		color: white;
	}
	.text-sec2 h2 {
		font-size: 30px;
		font-weight: 400;
		color: white;
	}
	.text-sec2 p {
		font-size: 1.2rem;
		color: white;
	}

	/* TIER 3 */
	/* 1. Contenedor principal */

	.tier-3-container {
		display: grid;
		grid-template-columns: 440px 640px; /* Crea dos columnas del mismo tamaño */
		gap: 32px; /* Espacio entre el video y el texto */
		align-items: center; /* Centra el contenido verticalmente */
		padding: 60px 0;
	}
	.tier-3-subgrid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 15px;
		max-width: 448px;
		/* margin: 0 auto; */

		/* Ya no necesitamos grid-template-rows, el aspect-ratio hará el trabajo */
	}

	/* 2. Estructura base de cada cuadro */
	.grid-item {
		position: relative; /* Necesario para contener el video */
		background-color: #121212;
		border-radius: 16px;
		overflow: hidden; /* Evita que las esquinas del video sobresalgan del borde redondeado */
	}

	/* 3. Comportamiento de los videos */
	.grid-item img {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		/* object-fit: cover hace que el video llene el cuadro sin aplastarse, 
     recortando los bordes si es necesario */
		object-fit: cover;
	}

	/* 4. Asignación de espacios y proporciones (Aspect Ratio) */

	/* Cuadro grande 1:1 */
	.box-1 {
		grid-column: span 2;
		aspect-ratio: 1 / 1;
	}

	/* Cuadro vertical 9:16 */
	.box-2 {
		grid-column: span 1;
		aspect-ratio: 9 / 19;
	}

	/* Cuadro vertical 9:16 (Fila 2) */
	.box-3 {
		grid-column: span 1;
		aspect-ratio: 9 / 19;
	}

	/* Cuadro grande 1:1 (Fila 2) */
	.box-4 {
		grid-column: span 2;
		aspect-ratio: 1 / 1;
	}

	/* Cuadro panorámico 8:3 (Fila 3) */
	.box-5 {
		grid-column: span 3;
		aspect-ratio: 9 / 3;
	}

	/* --- Diseño Responsivo para Celulares --- */
	@media (max-width: 768px) {
		.hero-grid {
			grid-template-columns: 1fr; /* Cambia a una sola columna */
			text-align: center; /* Centra el texto en móviles (opcional) */
			padding: 40px 40px;
			grid-row-end: -1;
		}

		.cta-group {
			justify-content: center; /* Centra los botones en móviles */
		}

		.text-column h1 {
			font-size: 2.2rem;
		}
	}
</style>
