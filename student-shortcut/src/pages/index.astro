---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/LandingPage/Hero.astro";
import Discover from "../components/LandingPage/Discover.astro";
import VideoGrid from "../components/LandingPage/VideoGrid.astro";

export const prerender = false;
const { tittle } = Astro.props;
---

<Layout title={tittle}>
	<main>
		<Hero />
		<Discover />
		<VideoGrid />
	</main>
</Layout>

<style>
	main {
		padding-top: 85px; /* Offset for fixed header */
		/* background: #ffffff; */
		padding-bottom: 0;
		margin-bottom: 0;
		background-image:
			url("/img/noise.png"),
			linear-gradient(
				180deg,
				rgba(255, 255, 255, 1) 14%,
				rgba(31, 156, 201, 1) 55%,
				rgba(0, 91, 151, 1) 100%
			);
		background-repeat: repeat;
	}
</style>
