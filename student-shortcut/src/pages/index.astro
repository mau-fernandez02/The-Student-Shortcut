---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/LandingPage/Hero.astro";
import Discover from "../components/LandingPage/Discover.astro";
import VideoGrid from "../components/LandingPage/VideoGrid.astro";

export const prerender = false;
const { tittle } = Astro.props;
---

<Layout title={tittle}>
	<main class="landing-main">
		<Hero />
		<div class="landing-flow-wrapper">
			<Discover />
			<VideoGrid />
		</div>
	</main>
</Layout>

<style>
	.landing-main {
		/* Para el header tiene un 85px */
		/* background: #ffffff; */

		background-image:
			url("/img/noise.png"),
			linear-gradient(
				180deg,
				rgba(255, 255, 255, 1) 14%,
				rgba(31, 156, 201, 1) 55%,
				rgba(0, 91, 151, 1) 100%
			);
		background-repeat: repeat, no-repeat;
		background-size:
			auto,
			100% 100%;
		background-color: #005b97;
		position: relative;
		overflow-x: hidden;
	}

	.landing-flow-wrapper {
		position: relative;
		width: 100%;
	}
</style>
