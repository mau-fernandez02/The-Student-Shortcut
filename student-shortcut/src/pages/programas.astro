---
// src/pages/programas.astro
import Layout from "../layouts/Layout.astro";
import Programa1 from "../components/Programas/Programa1.astro";
import Programa2 from "../components/Programas/Programa2.astro";
import Carrusel from "../components/Carrusel.astro";

interface Props {
  pageTitle?: string;
  sectionTitle?: string;
}

const {
  pageTitle = "Nuestros Programas",
  sectionTitle = "Nuestros programas",
} = Astro.props;
---

<Layout title={pageTitle}>
  <main class="programs-page">
    <!-- Sección Principal de Programas -->
    <section class="programs-page__section">
      <h1 class="programs-page__title" data-i18n="programs.pageTitle">{sectionTitle}</h1>

      <!-- Carrusel Interactivo de Programas -->
      <Carrusel>
        <Programa1 />
        <Programa2 />
      </Carrusel>
    </section>

    <!-- Capas Decorativas (Montañas según PDF 1 pág 3) -->
    <div class="programs-page__mountain programs-page__mountain--top-left" aria-hidden="true">
      <img src="/img/SVG/Montaña_12.svg" alt="" width="400" height="300" loading="eager" />
    </div>

    <div class="programs-page__mountain programs-page__mountain--top-right" aria-hidden="true">
      <img src="/img/SVG/Montaña_7.svg" alt="" width="450" height="300" loading="eager" />
    </div>

    <div class="programs-page__mountain programs-page__mountain--bottom-right" aria-hidden="true">
      <img src="/img/SVG/Montaña_9.svg" alt="" width="480" height="320" loading="lazy" />
    </div>

    <div class="programs-page__mountain programs-page__mountain--bottom-left" aria-hidden="true">
      <img src="/img/SVG/Montaña_11.svg" alt="" width="550" height="350" loading="lazy" />
    </div>
  </main>
</Layout>

<style>
  /* Contenedor Principal de la Página (Requerimiento 4: Fondo degradado corregido) */
  .programs-page {
    position: relative;
    width: 100%;
    overflow: hidden;
    min-height: calc(100vh - 75px);
    background-color: #005b97;
    background-image:
      url("/img/noise.png"),
      linear-gradient(180deg, #bde3fa 0%, #1e9cd7 22%, #0e7db4 58%, #005b97 100%);
    background-repeat: repeat, no-repeat;
    background-size: auto, 100% 100%;
  }

  /* Layout de la Sección */
  .programs-page__section {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 30px;
    justify-content: flex-start;
    align-items: flex-start;
    width: min(88%, 1200px);
    min-height: calc(100vh - 75px);
    margin-left: auto;
    margin-right: auto;
    padding-top: 130px;
    padding-bottom: 120px;
  }

  /* Encabezado */
  .programs-page__title {
    position: relative;
    z-index: 2;
    color: #ffffff;
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    font-weight: 800;
    text-align: left;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
    margin: 0;
  }

  /* Estilos para las capas decorativas */
  .programs-page__mountain {
    position: absolute;
    z-index: 1;
    pointer-events: none;
  }

  .programs-page__mountain img {
    width: 100%;
    height: auto;
    display: block;
    user-select: none;
    pointer-events: none;
  }

  .programs-page__mountain--top-left {
    top: -60px;
    left: -30px;
    width: 400px;
    transform: scaleX(-1) rotate(-90deg);
    opacity: 0.85;
  }

  .programs-page__mountain--top-right {
    top: -90px;
    right: -30px;
    width: 450px;
    transform: scaleX(1) rotate(-90deg);
    opacity: 0.85;
  }

  .programs-page__mountain--bottom-right {
    bottom: -100px;
    right: 0px;
    width: 480px;
    transform: scaleX(1) rotate(-90deg);
    opacity: 0.9;
  }

  .programs-page__mountain--bottom-left {
    bottom: -100px;
    left: 50px;
    width: 550px;
    transform: scaleX(-1) rotate(-90deg);
    opacity: 0.9;
  }

  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .programs-page__section {
      width: 92%;
      padding-top: 95px;
      padding-bottom: 70px;
      align-items: center;
    }

    .programs-page__title {
      text-align: center;
    }

    .programs-page__mountain {
      display: none;
    }
  }
</style>