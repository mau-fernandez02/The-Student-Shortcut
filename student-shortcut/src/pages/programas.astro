---
import Layout from "../layouts/Layout.astro";
import Programa1 from "../components/Programas/Programa1.astro";
import Programa2 from "../components/Programas/Programa2.astro";
---

<!-- Nuestros Programas -->
<Layout title="Nuestros Programas">
    <section class="programas container">
        <h1>Nuestros programas</h1>
        <div class="carrusel-programas">
            <Programa1 />

            <Programa2 />
        </div>
    </section>
</Layout>

<style>
    .carrusel-programas {
        display: flex;
        flex-direction: row;
        gap: 20px;
        align-items: center;
        justify-content: center;
    }
</style>
