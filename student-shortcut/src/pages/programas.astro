---
import Layout from "../layouts/Layout.astro";
import Programa1 from "../components/Programas/Programa1.astro";
import Programa2 from "../components/Programas/Programa2.astro";

import Carrusel from "../components/Carrusel.astro";
---

<!-- Nuestros Programas -->
<Layout title="Nuestros Programas">
  <main>
    <section class="programas">
      <h1>Nuestros programas</h1>
      <!-- Usamos el carrusel y le pasamos los programas como hijos -->

      <Carrusel>
        <Programa1 />
        <Programa2 />
        <!-- En el futuro solo tienes que agregar <Programa3 /> aquí y funcionará automáticamente -->
      </Carrusel>
    </section>
    <div class="montana-a">
      <img src="/img/SVG/Montaña_12.svg" alt="" />
    </div>
    <div class="montana-b">
      <img src="/img/SVG/Montaña_7.svg" alt="" />
    </div>
    <div class="montana-c">
      <img src="/img/SVG/Montaña_9.svg" alt="" />
    </div>
  </main>
</Layout>

<style>
  main {
    /* Offset for fixed header */
    /* background: #ffffff; */
    background-image:
      url("/img/noise.png"),
      linear-gradient(180deg, rgba(255, 255, 255, 1) -30%, #1e9cd7 50%);
    background-repeat: repeat;
    width: 100%;
    position: relative;
    overflow: hidden; /* Forma simplificada y estándar */
    width: 100%; /* Permite el desplazamiento vertical si es necesario */
  }

  .montana-a {
    position: absolute;
    z-index: 1;
    top: -90px;
    left: -30px;
    width: 500px;
    rotate: 0deg;
    transform: scaleX(-1) rotate(-90deg);
  }
  .montana-b {
    position: absolute;
    z-index: 1;
    top: -90px;
    right: -30px;
    width: 500px;
    rotate: 0deg;
    transform: scaleX(1) rotate(-90deg);
  }
  .montana-c {
    position: absolute;
    z-index: 1;
    bottom: -100px;
    right: 0px;
    width: 480px;
    rotate: 0deg;
    transform: scaleX(1) rotate(-90deg);
  }

  .programas {
    z-index: 2;
    padding-top: 140px;
    padding-bottom: 140px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    justify-content: start;
    align-items: start;
    margin: 0 auto;
    max-width: 1280px;
    width: 100%;
  }

  .programas h1 {
    z-index: 2;
    color: #ffffff;
    font-size: 40px;
    font-weight: 700;
    text-align: center;
  }
  .carrusel-programas {
    display: flex;
    flex-direction: row;
    gap: 20px;
    align-items: center;
    justify-content: center;
  }
</style>
