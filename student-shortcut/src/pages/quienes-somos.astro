---
// src/pages/quienes-somos.astro
import Layout from "../layouts/Layout.astro";
import QuienesSomos from "../components/QuienesSomos/QuienesSomos.astro";
import NuestroEquipo from "../components/QuienesSomos/NuestroEquipo.astro";
import Equipo from "../components/QuienesSomos/Equipo.astro";
---

<Layout
  title="Quiénes Somos | The Student Shortcut"
  description="Conoce al equipo y la visión detrás de The Student Shortcut. Te acompañamos en tu experiencia de intercambio cultural y académico."
>
  <main class="about-page">
    <!-- Decoración de fondo de Montaña según los nuevos assets -->
    <div class="about-hero__bg-mountain" aria-hidden="true">
      <img src="/img/nubes-montanas/Montaña-QuienesSomos.png" alt="" loading="eager" />
    </div>

    <!-- Secciones principales -->
    <QuienesSomos />
    <NuestroEquipo />
    <Equipo />
  </main>
</Layout>

<style>
  .about-page {
    position: relative;
    width: 100%;
    min-height: 100vh;
    padding-top: var(--header-height, 75px);
    padding-bottom: 60px;
    background-color: #005b97;
    background-image:
      url("/img/noise.png"),
      linear-gradient(180deg, #1e9cd7 0%, #127eb5 45%, #005b97 100%);
    background-repeat: repeat, no-repeat;
    background-size: auto, 100% 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .about-hero__bg-mountain {
    position: absolute;
    top: -60px;
    left: -120px;
    width: min(740px, 55vw);
    opacity: 0.85;
    pointer-events: none;
    z-index: 1;
  }

  .about-hero__bg-mountain img {
    width: 100%;
    height: auto;
    user-select: none;
  }

  @media (max-width: 768px) {
    .about-hero__bg-mountain {
      display: none;
    }
  }
</style>
