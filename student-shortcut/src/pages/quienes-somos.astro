---
// src/pages/quienes-somos.astro
import Layout from "../layouts/Layout.astro";
import QuienesSomos from "../components/QuienesSomos/QuienesSomos.astro";
import NuestroEquipo from "../components/QuienesSomos/NuestroEquipo.astro";
import Equipo from "../components/QuienesSomos/Equipo.astro";
---

<Layout 
  title="Quiénes Somos | Student Shortcut" 
  description="Conoce al equipo y la visión detrás de Student Shortcut. Te acompañamos en tu experiencia de intercambio cultural y académico."
>
  <main class="about-page">
    <!-- Secciones principales -->
    <QuienesSomos />
    <NuestroEquipo />
    <Equipo />
  </main>
</Layout>

<style>
  .about-page {
    position: relative;
    width: 100%;
    min-height: 100vh;
    /* Offset para evitar que el header fijo tape el inicio del contenido */
    padding-top: var(--header-height, 75px);
    padding-bottom: 60px;
    
    /* Fondo con gradiente y textura de ruido */
    background-color: #1f9cc9;
    background-image:
      url("/img/noise.png"),
      linear-gradient(180deg, #0cabe6 0%, #1f9cc9 55%, #005b97 100%);
    background-repeat: repeat, no-repeat;
    background-size: auto, cover;
    
    /* Asegura que los componentes mantengan el flujo vertical */
    display: flex;
    flex-direction: column;
  }
</style>