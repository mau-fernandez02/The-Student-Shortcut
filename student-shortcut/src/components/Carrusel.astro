---
// src/components/Carrusel.astro

interface Props {
  ariaLabel?: string;
}

const { ariaLabel = "Carrusel de contenido" } = Astro.props;
---

<div class="carousel" aria-label={ariaLabel}>
  <div class="carousel__wrapper">
    <!-- Botón Navegación Anterior -->
    <button 
      class="carousel__btn carousel__btn--prev" 
      aria-label="Diapositiva anterior"
      type="button"
    >
      <svg
        viewBox="0 0 24 24"
        width="24"
        height="24"
        stroke="currentColor"
        stroke-width="2"
        fill="none"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <!-- Contenedor Pista (Slots Inyectados) -->
    <div class="carousel__track">
      <slot />
    </div>

    <!-- Botón Navegación Siguiente -->
    <button 
      class="carousel__btn carousel__btn--next" 
      aria-label="Siguiente diapositiva"
      type="button"
    >
      <svg
        viewBox="0 0 24 24"
        width="24"
        height="24"
        stroke="currentColor"
        stroke-width="2"
        fill="none"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>

  <!-- Contenedor Dinámico para Indicadores (Puntos) -->
  <div class="carousel__dots" role="tablist" aria-label="Indicadores de diapositivas"></div>
</div>

<style>
  /* Contenedor Principal */
  .carousel {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .carousel__wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  /* Pista Deslizable */
  .carousel__track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    width: 100%;
    padding: 20px 10px;

    /* Ocultar barra de desplazamiento */
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .carousel__track::-webkit-scrollbar {
    display: none;
  }

  /* Ajuste de elementos hijos inyectados por slot */
  .carousel__track > :global(*) {
    flex: 0 0 100%;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
    scroll-snap-align: center;
  }

  /* Botones de Navegación */
  .carousel__btn {
    position: absolute;
    z-index: 10;
    background-color: rgba(255, 255, 255, 0);
    color: #92fbff;
    border-radius: 50%;
    border: none;
    width: 40px;
    height: 40px;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }

  .carousel__btn:hover {
    background-color: rgba(248, 249, 250, 0.57);
    transform: scale(1.1);
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.15);
  }

  .carousel__btn--prev {
    left: -60px;
  }

  .carousel__btn--next {
    right: -60px;
  }

  /* Indicadores Dinámicos (Puntos) */
  .carousel__dots {
    z-index: 10;
    display: flex;
    justify-content: center;
    gap: 10px;
  }

  :global(.carousel__dot) {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: #d1d5db;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.3s ease;
  }

  :global(.carousel__dot--active) {
    background-color: #09c6ff;
    transform: scale(1.2);
  }

  /* Media Queries */
  @media (max-width: 1300px) {
    .carousel__btn--prev {
      left: -10px;
    }
    .carousel__btn--next {
      right: -10px;
    }
    .carousel__track {
      gap: 60px;
      padding: 10px 0;
    }
  }
</style>

<script>
  function initializeCarousels() {
    const carousels = document.querySelectorAll(".carousel");

    carousels.forEach((carousel) => {
      const track = carousel.querySelector(".carousel__track") as HTMLElement;
      const btnPrev = carousel.querySelector(".carousel__btn--prev");
      const btnNext = carousel.querySelector(".carousel__btn--next");
      const dotsContainer = carousel.querySelector(".carousel__dots");

      if (!track || !btnPrev || !btnNext || !dotsContainer) return;

      // 1. Generar puntos dinámicamente según la cantidad de elementos
      const totalItems = track.children.length;
      dotsContainer.innerHTML = "";

      for (let i = 0; i < totalItems; i++) {
        const dot = document.createElement("button");
        dot.classList.add("carousel__dot");
        if (i === 0) dot.classList.add("carousel__dot--active");
        
        dot.setAttribute("type", "button");
        dot.setAttribute("role", "tab");
        dot.setAttribute("aria-label", `Ir a la diapositiva ${i + 1}`);

        dot.addEventListener("click", () => {
          const itemWidth = track.clientWidth;
          track.scrollTo({
            left: itemWidth * i,
            behavior: "smooth",
          });
        });

        dotsContainer.appendChild(dot);
      }

      const dots = dotsContainer.querySelectorAll(".carousel__dot");

      // 2. Sincronizar puntos con el evento de desplazamiento (scroll)
      track.addEventListener("scroll", () => {
        const itemWidth = track.clientWidth;
        const activeIndex = Math.round(track.scrollLeft / itemWidth);

        dots.forEach((dot, index) => {
          if (index === activeIndex) {
            dot.classList.add("carousel__dot--active");
            dot.setAttribute("aria-selected", "true");
          } else {
            dot.classList.remove("carousel__dot--active");
            dot.setAttribute("aria-selected", "false");
          }
        });
      });

      // 3. Eventos para las flechas de navegación
      btnPrev.addEventListener("click", () => {
        const itemWidth = track.clientWidth;
        track.scrollBy({ left: -itemWidth, behavior: "smooth" });
      });

      btnNext.addEventListener("click", () => {
        const itemWidth = track.clientWidth;
        track.scrollBy({ left: itemWidth, behavior: "smooth" });
      });
    });
  }

  // Compatible con carga normal y Astro View Transitions
  document.addEventListener("DOMContentLoaded", initializeCarousels);
  document.addEventListener("astro:page-load", initializeCarousels);
</script>