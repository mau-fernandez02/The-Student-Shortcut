---
// src/components/Carrusel.astro

interface Props {
  ariaLabel?: string;
}

const { ariaLabel = "Carrusel de programas" } = Astro.props;
---

<div class="carousel" aria-label={ariaLabel}>
  <div class="carousel__wrapper">
    <!-- Botón Navegación Anterior (Flecha Izquierda) -->
    <button 
      class="carousel__btn carousel__btn--prev carousel__btn--hidden" 
      aria-label="Programa anterior"
      type="button"
    >
      <svg
        viewBox="0 0 24 24"
        width="28"
        height="28"
        stroke="currentColor"
        stroke-width="2.5"
        fill="none"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <!-- Contenedor Pista (Slots Inyectados) -->
    <div class="carousel__track">
      <slot />
    </div>

    <!-- Botón Navegación Siguiente (Flecha Derecha) -->
    <button 
      class="carousel__btn carousel__btn--next" 
      aria-label="Siguiente programa"
      type="button"
    >
      <svg
        viewBox="0 0 24 24"
        width="28"
        height="28"
        stroke="currentColor"
        stroke-width="2.5"
        fill="none"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>

  <!-- Contenedor Dinámico para Indicadores (Puntos) -->
  <div class="carousel__dots" role="tablist" aria-label="Indicadores de diapositivas"></div>
</div>

<style>
  /* Contenedor Principal */
  .carousel {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .carousel__wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    padding: 0 54px;
    box-sizing: border-box;
  }

  /* Pista Deslizable */
  .carousel__track {
    display: flex;
    gap: 30px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    width: 100%;
    padding: 10px 0;

    /* Ocultar barra de desplazamiento */
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .carousel__track::-webkit-scrollbar {
    display: none;
  }

  /* Ajuste de elementos hijos inyectados por slot */
  .carousel__track > :global(*) {
    flex: 0 0 100%;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
    scroll-snap-align: center;
  }

  /* Botones de Navegación (Flechas) - Corrección 7: No superponer con texto */
  .carousel__btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;
    background: rgba(255, 255, 255, 0.25);
    border: 2px solid #ffffff;
    color: #ffffff;
    border-radius: 50%;
    width: 48px;
    height: 48px;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(8px);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s ease, background 0.3s ease;
  }

  .carousel__btn:hover {
    background: #ffffff;
    color: #005b97;
    transform: translateY(-50%) scale(1.12);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
  }

  .carousel__btn--prev {
    left: 2px;
  }

  .carousel__btn--next {
    right: 2px;
  }

  /* Requerimiento 9: Que desaparezcan según el lado que se está visualizando */
  .carousel__btn--hidden {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    transform: translateY(-50%) scale(0.75) !important;
  }

  /* Indicadores Dinámicos (Puntos) */
  .carousel__dots {
    z-index: 10;
    display: flex;
    justify-content: center;
    gap: 12px;
  }

  :global(.carousel__dot) {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.4);
    border: 1.5px solid #ffffff;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.3s ease;
  }

  :global(.carousel__dot--active) {
    background-color: #ffffff;
    transform: scale(1.3);
  }

  /* Media Queries */
  @media (max-width: 768px) {
    .carousel__wrapper {
      padding: 0 42px;
    }
    .carousel__btn {
      width: 40px;
      height: 40px;
    }
    .carousel__btn--prev {
      left: 2px;
    }
    .carousel__btn--next {
      right: 2px;
    }
  }

  @media (max-width: 500px) {
    .carousel__wrapper {
      padding: 0 26px;
    }
    .carousel__btn {
      width: 34px;
      height: 34px;
    }
    .carousel__btn--prev {
      left: 0;
    }
    .carousel__btn--next {
      right: 0;
    }
  }
</style>

<script>
  function initializeCarousels() {
    const carousels = document.querySelectorAll(".carousel");

    carousels.forEach((carousel) => {
      const track = carousel.querySelector(".carousel__track") as HTMLElement;
      const btnPrev = carousel.querySelector(".carousel__btn--prev") as HTMLElement;
      const btnNext = carousel.querySelector(".carousel__btn--next") as HTMLElement;
      const dotsContainer = carousel.querySelector(".carousel__dots") as HTMLElement;

      if (!track || !btnPrev || !btnNext || !dotsContainer) return;

      const items = Array.from(track.children) as HTMLElement[];
      const totalItems = items.length;
      if (totalItems <= 1) {
        btnPrev.classList.add("carousel__btn--hidden");
        btnNext.classList.add("carousel__btn--hidden");
        dotsContainer.style.display = "none";
        return;
      }

      dotsContainer.innerHTML = "";

      const getActiveIndex = () => {
        const scrollLeft = track.scrollLeft;
        const itemWidth = items[0]?.offsetWidth || track.clientWidth;
        const index = Math.round(scrollLeft / itemWidth);
        return Math.min(Math.max(0, index), totalItems - 1);
      };

      const scrollToItem = (index: number) => {
        const item = items[index];
        if (!item) return;
        track.scrollTo({ left: item.offsetLeft, behavior: "smooth" });
      };

      // Requerimiento 9: Desaparecer las flechas según el lado que se está visualizando
      const updateNavigation = () => {
        const scrollLeft = track.scrollLeft;
        const maxScroll = track.scrollWidth - track.clientWidth;
        const activeIndex = getActiveIndex();

        // Si estamos al inicio (slide 0 / lado izquierdo), desaparece la flecha izquierda
        const isAtStart = scrollLeft <= 15 || activeIndex === 0;
        // Si estamos al final (último slide / lado derecho), desaparece la flecha derecha
        const isAtEnd = scrollLeft >= maxScroll - 15 || activeIndex === totalItems - 1;

        if (isAtStart) {
          btnPrev.classList.add("carousel__btn--hidden");
        } else {
          btnPrev.classList.remove("carousel__btn--hidden");
        }

        if (isAtEnd) {
          btnNext.classList.add("carousel__btn--hidden");
        } else {
          btnNext.classList.remove("carousel__btn--hidden");
        }

        const dots = dotsContainer.querySelectorAll(".carousel__dot");
        dots.forEach((dot, index) => {
          dot.classList.toggle("carousel__dot--active", index === activeIndex);
          dot.setAttribute("aria-selected", String(index === activeIndex));
        });
      };

      for (let i = 0; i < totalItems; i++) {
        const dot = document.createElement("button");
        dot.classList.add("carousel__dot");
        if (i === 0) dot.classList.add("carousel__dot--active");
        
        dot.setAttribute("type", "button");
        dot.setAttribute("role", "tab");
        dot.setAttribute("aria-label", `Ir al programa ${i + 1}`);

        dot.addEventListener("click", () => {
          scrollToItem(i);
        });

        dotsContainer.appendChild(dot);
      }

      track.addEventListener("scroll", updateNavigation, { passive: true });
      window.addEventListener("resize", updateNavigation);

      btnPrev.addEventListener("click", () => {
        const target = Math.max(0, getActiveIndex() - 1);
        scrollToItem(target);
      });

      btnNext.addEventListener("click", () => {
        const target = Math.min(totalItems - 1, getActiveIndex() + 1);
        scrollToItem(target);
      });

      // Ejecutar inmediatamente
      setTimeout(updateNavigation, 50);
      updateNavigation();
    });
  }

  document.addEventListener("DOMContentLoaded", initializeCarousels);
  document.addEventListener("astro:page-load", initializeCarousels);
</script>