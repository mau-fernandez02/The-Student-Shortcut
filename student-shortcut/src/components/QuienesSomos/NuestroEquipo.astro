---
// src/components/QuienesSomos/NuestroEquipo.astro

interface TeamMember {
  name: string;
  role: string;
  bioKeys: string[];
  bio: string[];
  imageSrc: string;
}

const teamMembers: TeamMember[] = [
  {
    name: "Esteban Daza",
    role: "Co-Founder & CPO",
    imageSrc: "/img/team/Esteban.png",
    bioKeys: ["about.esteban.bio1", "about.esteban.bio2", "about.esteban.bio3"],
    bio: [
      "Esteban siempre ha entendido el mundo como un lugar para aprender. Como ex estudiante de intercambio en Estados Unidos, con formación en Italia y experiencias en diferentes culturas, descubrió que salir de casa también transforma quién eres.",
      "Como Ingeniero Industrial y cofundador de The Student Shortcut, combina su experiencia internacional con una visión estratégica y humana para acompañar a estudiantes en experiencias que impulsen su crecimiento, independencia y autodescubrimiento.",
      "Para Esteban, viajar no es solo conocer el mundo; sino descubrir una versión más grande de ti mismo."
    ],
  },
  {
    name: "Fabrizio Aramayo",
    role: "Co-Founder & CMO",
    imageSrc: "/img/team/Fabri2.png",
    bioKeys: ["about.fabrizio.bio1", "about.fabrizio.bio2"],
    bio: [
      "Habiendo realizado sus estudios superiores en Francia, comprendió algo que hoy es el motor de The Student Shortcut: salir al mundo no es solo un viaje, es la herramienta de transformación personal y profesional más potente que existe.",
      "Posteriormente, su sólida trayectoria en el terreno audiovisual es su mayor ventaja como CMO. No se trata solo de hacer videos bonitos, sino de poseer la sensibilidad y la visión exacta para descifrar la esencia de cada estudiante, convertirla en una historia memorable y plasmarla en imágenes que conectan de verdad."
    ],
  }
];
---

<section class="team-section">
  <div class="team-section__container">
    <h2 class="team-section__title" data-i18n="about.team.title">NUESTRO EQUIPO</h2>

    <div class="team-section__list">
      {
        teamMembers.map((member, index) => {
          const isEven = index % 2 === 1;
          return (
            <article class={`team-card ${isEven ? "team-card--reverse" : ""}`}>
              <!-- Información y Bio -->
              <div class="team-card__content">
                <header class="team-card__header">
                  <h3 class="team-card__name">{member.name}</h3>
                  <span class="team-card__role">{member.role}</span>
                </header>

                <div class="team-card__bio">
                  {member.bio.map((paragraph, pIdx) => (
                    <p data-i18n={member.bioKeys[pIdx]}>{paragraph}</p>
                  ))}
                </div>
              </div>

              <!-- Media / Fotografía del integrante -->
              <div class="team-card__media">
                <div class="team-card__image-wrapper">
                  <img
                    src={member.imageSrc}
                    alt={`Fotografía de ${member.name}`}
                    class="team-card__image"
                    loading="lazy"
                  />
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .team-section {
    width: 100%;
    padding: 60px 0;
    color: #ffffff;
  }

  .team-section__container {
    width: min(90%, 1100px);
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .team-section__title {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
    text-align: center;
  }

  .team-section__list {
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
  }

  /* Tarjeta de integrante */
  .team-card {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: 3.5rem;
    background: rgba(255, 255, 255, 0.08);
    border: 0px solid rgba(92, 92, 92, 0.055);
    border-radius: 24px;
    padding: clamp(24px, 4vw, 40px);
    backdrop-filter: blur(8px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.15);
  }

  .team-card--reverse {
    grid-template-columns: 1fr 1.2fr;
  }

  .team-card--reverse .team-card__content {
    order: 2;
  }

  .team-card--reverse .team-card__media {
    order: 1;
  }

  /* Textos */
  .team-card__content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .team-card__header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .team-card__name {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    font-weight: 800;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
    line-height: 1.1;
  }

  .team-card__role {
    font-size: 1.05rem;
    font-weight: 700;
    color: #d8f1fc;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .team-card__bio {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .team-card__bio p {
    font-size: clamp(0.95rem, 1.8vw, 1.08rem);
    font-weight: 400;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.95);
    margin: 0;
  }

  /* Media Card */
  .team-card__media {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .team-card__image-wrapper {
    position: relative;
    width: 100%;
    max-width: 360px;
    aspect-ratio: 1 / 1;
    background-color: #000000;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.28);
    
  }

  .team-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .team-card:hover .team-card__image {
    transform: scale(1.03);
  }

  @media (max-width: 860px) {
    .team-card,
    .team-card--reverse {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
    }

    .team-card--reverse .team-card__content,
    .team-card__content {
      order: 2;
      align-items: center;
    }

    .team-card--reverse .team-card__media,
    .team-card__media {
      order: 1;
    }

    .team-card__image-wrapper {
      max-width: 260px;
    }
  }
</style>