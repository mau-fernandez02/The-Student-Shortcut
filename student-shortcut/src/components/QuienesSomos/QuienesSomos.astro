  <div class="montana-a">
    <img src="/img/SVG/Montaña_5.svg" alt="" />
  </div>
</section>

<style>
  .qs-section {
    padding-top: 180px;
    padding-bottom: 100px;
    /* Offset for fixed header */
    display: flex;
    flex-direction: column;
    gap: 20px;
    justify-content: center;
    align-items: center;
    margin: 0px auto;

    width: 100%;
    position: relative;
    overflow: hidden; /* Forma simplificada y estándar */
  }
  .montana-a {
    position: absolute;
    z-index: 1;
    top: -190px;
    left: -250px;
    width: 900px;
    rotate: 0deg;
    transform: rotate(90deg);
  }
  .montana-a img {
    width: 100%;
    user-select: none; /* Previene la selección */
    pointer-events: none;
  }

  .text-qs {
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: 25px;
    justify-content: center;
    align-items: start;
    margin: 0px auto;
    width: min(100%, 1200px);
    padding: min(8%, 50px);
  }

  .text-qs h2 {
    color: #ffffff;
    font-size: 50px;
    font-weight: 600;
  }

  .text-qs p {
    color: #ffffff;
    font-size: 20px;
    text-align: justify;
  }

  /* Tarjetas de misión y visión */

  .mision-vision {
    margin: 0px auto;
    width: min(100%, 1000px);
    display: flex;
    overflow-x: auto;

    z-index: 2; /* Para que esté sobre la montaña */
  }
  .mision-vision::-webkit-scrollbar {
    display: none; /* Oculta la barra de desplazamiento en navegadores basados en WebKit */
  }

  .group {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 1em;
    animation: spin 15s linear infinite;
    padding-right: 2em; /* Espacio para que la animación no se corte */
  }

  .ms-card {
    flex: 0 0 500px; /* Cada tarjeta ocupa la mitad del contenedor menos el gap */
    padding: 30px 20px;
    display: flex;


    flex-direction: column;
    gap: 1em;
    justify-content: center;
    align-items: center;
    min-width: 280px;

    border-radius: 10px;
    background: transparent;
  }

  .ms-card p {
    color: #000;
    font-size: clamp(1rem, 2vw, 1.2rem);
    text-align: center;
    line-height: 1.6;
  }

  .ms-card h3 {
    text-align: center;
    color: #000;
    font-size: clamp(1.8rem, 5vw, 2.1rem);
    font-weight: 700;
  }

  .ms-img {
    width: clamp(80px, 15vw, 100px);
    height: clamp(80px, 15vw, 100px);
    background-color: rgba(240, 248, 255, 0.658);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 10px;
    flex-shrink: 0;
  }

  .ms-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @keyframes spin {
    from {
      translate: 0;
    }
    to {
      translate: -100%;
    }
  }


  @media (max-width: 1000px) {
    .mision-vision {
      animation: spin 15s linear infinite;
    }

  }
</style>
