---
// src/components/QuienesSomos/QuienesSomos.astro
---

<section class="about-hero">
  <!-- Decoración de fondo -->
  <div class="about-hero__bg-mountain" aria-hidden="true">
    <img src="/img/SVG/Montaña_5.svg" alt="" loading="eager" />
  </div>

  <!-- Contenido Principal -->
  <div class="about-hero__content">
    <h1 class="about-hero__title">¿Quiénes Somos?</h1>
    <div class="about-hero__description">
      <p>
        <strong>Student Shortcut</strong> es una empresa boliviana creada para conectar a
        jóvenes con diferentes oportunidades de intercambio cultural alrededor del
        mundo.
      </p>
      <p>
        Nacimos de nuestra propia experiencia internacional y de la convicción de
        que conocer otra cultura puede cambiar la manera en la que una persona
        entiende el mundo y su propio futuro.
      </p>
      <p>
        Por eso, buscamos simplificar el camino hacia una experiencia
        internacional brindando orientación cercana y acompañamiento durante cada
        etapa del proceso.
      </p>
    </div>
  </div>

  <!-- Carrusel Infinito de Misión y Visión -->
  <div class="about-hero__marquee" aria-label="Nuestra Misión y Visión">
    <div class="about-hero__marquee-track">
      <!-- Grupo 1 (Visible para lectores de pantalla) -->
      <div class="about-hero__marquee-group">
        <article class="about-card">
          <div class="about-card__icon-wrapper">
            <img src="/img/SVG/heart-half-stroke-svgrepo-com.svg" alt="Misión" class="about-card__icon" />
          </div>
          <h2 class="about-card__title">Nuestra Misión</h2>
          <p class="about-card__text">
            Brindar un servicio de calidad con un acompañamiento cercano y
            personalizado a cada estudiante, logrando que cada experiencia sea
            única, segura e inolvidable.
          </p>
        </article>

        <article class="about-card">
          <div class="about-card__icon-wrapper">
            <img src="/img/SVG/eye-3-svgrepo-com.svg" alt="Visión" class="about-card__icon" />
          </div>
          <h2 class="about-card__title">Nuestra Visión</h2>
          <p class="about-card__text">
            Ser la agencia referente de intercambios en Latinoamérica, inspirando
            y capacitando a las futuras generaciones para expandir sus horizontes globales.
          </p>
        </article>
      </div>

      <!-- Grupo 2 (Duplicado para loop visual) -->
      <div class="about-hero__marquee-group" aria-hidden="true">
        <article class="about-card">
          <div class="about-card__icon-wrapper">
            <img src="/img/SVG/heart-half-stroke-svgrepo-com.svg" alt="" class="about-card__icon" />
          </div>
          <h2 class="about-card__title">Nuestra Misión</h2>
          <p class="about-card__text">
            Brindar un servicio de calidad con un acompañamiento cercano y
            personalizado a cada estudiante, logrando que cada experiencia sea
            única, segura e inolvidable.
          </p>
        </article>

        <article class="about-card">
          <div class="about-card__icon-wrapper">
            <img src="/img/SVG/eye-3-svgrepo-com.svg" alt="" class="about-card__icon" />
          </div>
          <h2 class="about-card__title">Nuestra Visión</h2>
          <p class="about-card__text">
            Ser la agencia referente de intercambios en Latinoamérica, inspirando
            y capacitando a las futuras generaciones para expandir sus horizontes globales.
          </p>
        </article>
      </div>

      <!-- Grupo 3 (Asegura fluidez en pantallas ultra-anchas) -->
      <div class="about-hero__marquee-group" aria-hidden="true">
        <article class="about-card">
          <div class="about-card__icon-wrapper">
            <img src="/img/SVG/heart-half-stroke-svgrepo-com.svg" alt="" class="about-card__icon" />
          </div>
          <h2 class="about-card__title">Nuestra Misión</h2>
          <p class="about-card__text">
            Brindar un servicio de calidad con un acompañamiento cercano y
            personalizado a cada estudiante, logrando que cada experiencia sea
            única, segura e inolvidable.
          </p>
        </article>

        <article class="about-card">
          <div class="about-card__icon-wrapper">
            <img src="/img/SVG/eye-3-svgrepo-com.svg" alt="" class="about-card__icon" />
          </div>
          <h2 class="about-card__title">Nuestra Visión</h2>
          <p class="about-card__text">
            Ser la agencia referente de intercambios en Latinoamérica, inspirando
            y capacitando a las futuras generaciones para expandir sus horizontes globales.
          </p>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .about-hero {
    position: relative;
    width: 100%;
    padding: 60px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    overflow: hidden;
  }

  /* Elemento decorativo de montaña */
  .about-hero__bg-mountain {
    position: absolute;
    top: 0px;
    left: -180px;
    width: 750px;
    opacity: 0.85;
    pointer-events: none;
    z-index: 1;
    transform: rotate(90deg);
  }

  .about-hero__bg-mountain img {
    width: 100%;
    height: auto;
    user-select: none;
  }

  /* Bloque de texto */
  .about-hero__content {
    position: relative;
    z-index: 2;
    width: min(100%, 1100px);
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .about-hero__title {
    color: #ffffff;
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.2;
    margin: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.15);
  }

  .about-hero__description {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about-hero__description p {
    color: rgba(255, 255, 255, 0.95);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.7;
    margin: 0;
  }

  /* Carrusel Infinito (Marquee) */
  .about-hero__marquee {
    position: relative;
    z-index: 2;
    width: 100%;
    overflow: hidden;
    padding: 20px 0;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
  }

  .about-hero__marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 25s linear infinite;
  }

  .about-hero__marquee:hover .about-hero__marquee-track {
    animation-play-state: paused;
  }

  .about-hero__marquee-group {
    display: flex;
    gap: 2rem;
    padding-right: 2rem;
  }

  /* Tarjeta de Misión / Visión */
  .about-card {
    flex: 0 0 420px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 20px;
    padding: 2.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .about-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
  }

  .about-card__icon-wrapper {
    width: 75px;
    height: 75px;
    background-color: rgba(12, 171, 230, 0.12);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 16px;
    flex-shrink: 0;
  }

  .about-card__icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .about-card__title {
    color: #003b63;
    font-size: clamp(1.4rem, 3vw, 1.75rem);
    font-weight: 700;
    margin: 0;
  }

  .about-card__text {
    color: #4a5568;
    font-size: 0.975rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Animación */
  @keyframes marquee-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-33.333%);
    }
  }

  /* Adaptabilidad Móvil */
  @media (max-width: 600px) {
    .about-card {
      flex: 0 0 300px;
      padding: 1.75rem 1.25rem;
    }

    .about-hero__bg-mountain {
      width: 500px;
      left: -200px;
    }
  }
</style>