---
// src/components/QuienesSomos/Equipo.astro

interface TeamMember {
  name: string;
  imageSrc: string;
  imageAlt: string;
  role?: string;
  bio?: string;
}

const additionalMembers: TeamMember[] = [
  {
    name: "Cristina Matamoros",
    imageSrc: "#",
    imageAlt: "Fotografía de Cristina Matamoros"
  },
  {
    name: "Karina Reyes",
    imageSrc: "#",
    imageAlt: "Fotografía de Karina Reyes"
  },
  {
    name: "Nicolás Angulo",
    imageSrc: "#",
    imageAlt: "Fotografía de Nicolás Angulo"
  }
];
---

<section class="team-grid-section">
  <div class="team-grid-section__container">
    <div class="team-grid">
      {
        additionalMembers.map((member) => (
          <article class="member-card">
            <div class="member-card__image-wrapper">
              <img
                src={member.imageSrc}
                alt={member.imageAlt}
                class="member-card__image"
                loading="lazy"
              />
            </div>
            <h3 class="member-card__name">{member.name}</h3>
            {/* Opcional: Descomentar cuando la bio o el rol estén listos */}
            {/* {member.role && <span class="member-card__role">{member.role}</span>} */}
            {/* {member.bio && <p class="member-card__bio">{member.bio}</p>} */}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .team-grid-section {
    width: 100%;
    padding: 40px 0 80px 0;
  }

  .team-grid-section__container {
    width: min(100%, 1280px);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Distribución en rejilla responsiva */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    justify-content: center;
    justify-items: center;
    gap: 3rem 2.5rem;
  }

  /* Tarjeta de integrante */
  .member-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
    max-width: 260px;
    text-align: center;
  }

  /* Contenedor de la foto (Relación de aspecto 1:1) */
  .member-card__image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 20px;
    overflow: hidden;
    background-color: #000000;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .member-card:hover .member-card__image-wrapper {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
  }

  .member-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Nombre */
  .member-card__name {
    color: #ffffff;
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1.2;
    margin: 0;
    max-width: 200px;
  }

  /* Adaptabilidad Móvil */
  @media (max-width: 640px) {
    .team-grid {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 2.5rem 1.5rem;
    }

    .member-card {
      max-width: 220px;
    }
  }
</style>