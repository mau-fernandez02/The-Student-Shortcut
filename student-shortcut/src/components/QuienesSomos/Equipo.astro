---
// src/components/QuienesSomos/Equipo.astro

interface TeamMember {
  name: string;
  imageSrc: string;
}

const additionalMembers: TeamMember[] = [
  {
    name: "Cristina Matamoros",
    imageSrc: "/img/team/Personal-TSS_0000_Christina-1c.png",
  },
  {
    name: "Karina Reyes",
    imageSrc: "/img/team/Personal-TSS_0002_Kary-1.png",
  },
  {
    name: "Nicolás Angulo",
    imageSrc: "/img/team/Personal-TSS_0001_Nico-1.png",
  },
];
---

<section class="team-grid-section">
  <div class="team-grid-section__container">
    <div class="team-grid">
      {
        additionalMembers.map((member) => (
          <article class="member-card">
            <div class="member-card__image-wrapper">
              <img
                src={member.imageSrc}
                alt={`Fotografía de ${member.name}`}
                class="member-card__image"
                loading="lazy"
              />
            </div>
            <h3 class="member-card__name">{member.name}</h3>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .team-grid-section {
    width: 100%;
    padding: 30px 0 90px 0;
  }

  .team-grid-section__container {
    width: min(90%, 1100px);
    margin: 0 auto;
    padding: 0 24px;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    justify-content: center;
    justify-items: center;
    gap: 3rem 2.5rem;
  }

  .member-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
    max-width: 260px;
    text-align: center;
  }

  .member-card__image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 20px;
    overflow: hidden;
    background-color: #000000;
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.25);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .member-card:hover .member-card__image-wrapper {
    transform: translateY(-5px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
  }

  .member-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .member-card:hover .member-card__image {
    transform: scale(1.04);
  }

  .member-card__name {
    color: #ffffff;
    font-size: clamp(1.2rem, 2.5vw, 1.4rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1.2;
    margin: 0;
  }

  @media (max-width: 768px) {
    .team-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .member-card {
      max-width: 220px;
    }
  }
</style>
