---
// src/components/Hero.astro
---

<section class="hero-section">
    <div class="hero-grid">
        <div class="video-column">
            <video autoplay loop muted playsinline class="hero-video">
                <source src="/media/Vid-00001.webm" type="video/mp4" />
                Tu navegador no soporta la reproducción de video.
            </video>
        </div>

        <div class="text-column">
            <h1>
                Estudiar en el Extranjero...<br /> Nunca estuvo tan a tu alcance
            </h1>
            <p>
                Conquista tus habilidades en un nuevo país, nueva cultura, nuevo
                idioma.
            </p>
            <div class="cta-group">
                <a href="/programas" class="btn btn-primary">Ver Intercambios</a>
                <a href="/contactanos" class="btn boton-secundario">Contactanos...</a>
            </div>
        </div>
    </div>
    <div class="nube-a">
        <img src="/img/SVG/Nube_8.svg" alt="" />
    </div>
    <div class="nube-b">
        <img src="/img/SVG/Nube_10.svg" alt="" />
    </div>
</section>

<style>
    .boton-secundario {
        background-color: transparent;
        color: var(--color-primary, #1e9cd7);
        border: 1px solid var(--color-primary, #1e9cd7);
        transition: all 0.3s ease;
    }
    .boton-secundario:hover {
        background-color: var(--color-primary, #1e9cd7);
        color: #ffffff;
        transform: translateY(-2px);
    }

    .hero-section {
        position: relative;
        overflow: hidden; /* Forma simplificada y estándar */
        width: 100%; /* Permite el desplazamiento vertical si es necesario */
    }
    .nube-a {
        position: absolute;
        z-index: 2;
        bottom: 80px;
        left: -190px;
        width: min(800px, 60vw);
        rotate: 0deg;
        transform: scaleX(-1);
    }
    .nube-a img {
        width: 100%;
    }
    .nube-b {
        position: absolute;
        z-index: 2;
        bottom: 70px;
        right: -380px;
        width: min(890px, 60vw);
        rotate: 0deg;
        transform: rotate(5deg);
        /* overflow: hidden; */
    }
    .nube-b img {
        width: 100%;
    }

    .hero-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 32px;
        align-items: center;
        padding-top: 75px;
        padding-bottom: 325px;
        margin: 0 auto;
        width: min(85%, 1200px); /* Asegura que no desborde el body */
       
    }
    .video-column {
        width: 100%;
        aspect-ratio: 1 / 1;
        border-radius: 10px;
        overflow: hidden;
    }
    .hero-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .text-column h1 {
        font-size: clamp(2.8rem, 4vw, 3.5rem);
        margin-bottom: 20px;
    }
    .text-column p {
        font-size: clamp(0.9rem, 2vw, 1.2rem);
        margin-bottom: 30px;
        color: #555;
    }
    .cta-group {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
    }

    @media (max-width: 768px) {
        .hero-grid {
            grid-template-columns: 1fr;
            text-align: center;
            padding: 40px;
        }
        .cta-group {
            justify-content: center;
        }
        .text-column h1 {
            font-size: 2.2rem;
        }
    }
</style>
