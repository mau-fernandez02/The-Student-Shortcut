---
// src/components/LandingPage/VideoGrid.astro

interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaLink?: string;
}

const {
  title = "¡Cualquier sueño es posible si lo hacemos juntos!",
  subtitle = "Tu apuntas, ¡Y nosotros nos encargamos!",
  ctaText = "¡Inicia tu intercambio!",
  ctaLink = "/formulario",
} = Astro.props;

const paragraphs = [
  { key: "videogrid.p1", text: "El equipo de The Student Shortcut te acompaña en todo el proceso para que puedas disfrutar de tu Experiencia de Intercambio." },
  { key: "videogrid.p2", text: "Te asesoramos a lo largo de tu postulación para asegurar la mejor compatibilidad entre tú y tu destino." },
  { key: "videogrid.p3", text: "Nosotros nos encargamos de encontrar la mejor familia anfitriona para ti. Te ayudamos con el idioma para que la transición sea más sencilla." },
  { key: "videogrid.p4", text: "Simplificamos la relación entre colegios locales y extranjeros para la validación de materias y notas." }
];
---

<section class="video-grid">
  <!-- Layout Desktop (Rejilla de 5 videos a la izquierda, textos a la derecha) -->
  <div class="video-grid__container video-grid__container--desktop">
    <!-- Mosaico / Grid de 5 Vídeos (Desktop - Corrección 5) -->
    <div class="video-grid__mosaic">
      <!-- Fila 1: Video C (261x261) y Video D (165x261) -->
      <div class="video-grid__row video-grid__row--1">
        <div class="video-grid__box video-grid__box--c">
          <video autoplay loop muted playsinline class="video-grid__video">
            <source src="/media/VideoC-LandingPage.mp4" type="video/mp4" />
          </video>
        </div>
        <div class="video-grid__box video-grid__box--d">
          <video autoplay loop muted playsinline class="video-grid__video">
            <source src="/media/VideoD-LandingPage.mp4" type="video/mp4" />
          </video>
        </div>
      </div>

      <!-- Fila 2: Video E (165x261) y Video F (261x261) -->
      <div class="video-grid__row video-grid__row--2">
        <div class="video-grid__box video-grid__box--e">
          <video autoplay loop muted playsinline class="video-grid__video">
            <source src="/media/VideoE-LandingPage.mp4" type="video/mp4" />
          </video>
        </div>
        <div class="video-grid__box video-grid__box--f">
          <video autoplay loop muted playsinline class="video-grid__video">
            <source src="/media/VideoF-LandingPage.mp4" type="video/mp4" />
          </video>
        </div>
      </div>

      <!-- Fila 3: Video G (444x116) -->
      <div class="video-grid__box video-grid__box--g">
        <video autoplay loop muted playsinline class="video-grid__video">
          <source src="/media/VideoG-LandingPage.mp4" type="video/mp4" />
        </video>
      </div>
    </div>

    <!-- Bloque Informativo (Desktop) -->
    <div class="video-grid__content">
      <h2 class="video-grid__title" data-i18n="videogrid.title">{title}</h2>
      <h3 class="video-grid__subtitle" data-i18n="videogrid.subtitle">{subtitle}</h3>
      
      <div class="video-grid__description">
        {paragraphs.map((p) => (
          <p data-i18n={p.key}>{p.text}</p>
        ))}
      </div>

      <div class="video-grid__cta-group">
        <a href={ctaLink} class="btn-cta" data-i18n="videogrid.btn">
          {ctaText}
        </a>
      </div>
    </div>
  </div>

  <!-- Layout Móvil (Requerimiento 2: Video C -> Títulos -> Video D -> Párrafo -> Botón -> Avión) -->
  <div class="video-grid__container video-grid__container--mobile">
    <!-- 1. Video C Móvil (291x77) -->
    <div class="video-grid__mobile-box">
      <video autoplay loop muted playsinline class="video-grid__video">
        <source src="/media/Mobile/VideoC-LandingPage-Mobile.mp4" type="video/mp4" />
        <source src="/media/VideoC-LandingPage.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- 2. Título y Subtítulo -->
    <div class="video-grid__mobile-header">
      <h2 class="video-grid__title" data-i18n="videogrid.title">{title}</h2>
      <h3 class="video-grid__subtitle" data-i18n="videogrid.subtitle">{subtitle}</h3>
    </div>

    <!-- 3. Video D Móvil (291x77) -->
    <div class="video-grid__mobile-box">
      <video autoplay loop muted playsinline class="video-grid__video">
        <source src="/media/Mobile/VideoD-LandingPage-Mobile.mp4" type="video/mp4" />
        <source src="/media/VideoD-LandingPage.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- 4. Texto explicativo móvil -->
    <div class="video-grid__mobile-desc">
      <p data-i18n="videogrid.p1">{paragraphs[0].text}</p>
    </div>

    <!-- 5. Botón Móvil -->
    <div class="video-grid__cta-group">
      <a href={ctaLink} class="btn-cta" data-i18n="videogrid.btn">
        {ctaText}
      </a>
    </div>

    <!-- 6. Avión y trayecto en Móvil (Figma Landing Page V2 Mobile) -->
    <div class="flight-track-mobile-b" aria-hidden="true">
      <img
        src="/img/trayectos/TrayectoMobile-B.png"
        alt="Avión The Student Shortcut"
        class="flight-track-mobile-b__img"
        width="401"
        height="282"
        loading="lazy"
      />
    </div>
  </div>

  <!-- Capas Decorativas (Montañas V2) -->
  <div class="video-grid__mountain video-grid__mountain--left" aria-hidden="true">
    <img src="/img/nubes-montanas/Montaña-InfIzq-LandingPage-Desktop.png" alt="" width="380" height="680" loading="lazy" />
  </div>
  <div class="video-grid__mountain video-grid__mountain--right" aria-hidden="true">
    <img src="/img/nubes-montanas/Montaña-InfDer-LandingPage-Desktop.png" alt="" width="420" height="650" loading="lazy" />
  </div>
</section>

<style>
  .video-grid {
    position: relative;
    overflow: hidden;
    width: 100%;
    padding-top: 40px;
    padding-bottom: 240px;
  }

  /* Contenedor Desktop */
  .video-grid__container--desktop {
    position: relative;
    z-index: 5;
    display: grid;
    grid-template-columns: minmax(360px, 450px) 1.2fr;
    gap: 3.5rem;
    align-items: center;
    max-width: 1200px;
    width: min(88%, 1200px);
    margin: 0 auto;
  }

  .video-grid__container--mobile {
    display: none;
  }

  /* Mosaico de 5 Videos Desktop (Corrección 5: Fila 2 perfectamente alineada) */
  .video-grid__mosaic {
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 444px;
    max-width: 100%;
  }

  .video-grid__row {
    display: grid;
    gap: 18px;
    height: 261px;
    width: 100%;
  }

  .video-grid__row--1 {
    grid-template-columns: 261px 165px;
  }

  .video-grid__row--2 {
    grid-template-columns: 165px 261px;
  }

  .video-grid__box {
    position: relative;
    background-color: #000000;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.3);
    border: none;
    height: 100%;
  }

  .video-grid__box--g {
    width: 100%;
    height: 116px;
  }

  .video-grid__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Contenido Textual */
  .video-grid__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    color: #ffffff;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    position: relative;
    z-index: 5;
  }

  .video-grid__title {
    font-size: clamp(2.2rem, 3.8vw, 3rem);
    font-weight: 800;
    line-height: 1.2;
    color: #ffffff;
    margin: 0;
  }

  .video-grid__subtitle {
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    font-weight: 600;
    line-height: 1.4;
    color: #e0f4ff;
    margin: 0;
  }

  .video-grid__description {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .video-grid__description p {
    font-size: clamp(0.98rem, 1.8vw, 1.12rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.95);
    margin: 0;
  }

  /* Botón CTA y Avión (Corrección 6: Avión al lado del botón) */
  .video-grid__cta-group {
    margin-top: 0.5rem;
    z-index: 10;
    position: relative;
    display: inline-flex;
    align-items: center;
    width: fit-content;
  }

  .btn-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 32px;
    border-radius: 50px;
    background-color: transparent;
    color: #ffffff;
    border: 2px solid #ffffff;
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
  }

  .btn-cta:hover {
    background-color: #ffffff;
    color: #005b97;
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
  }

  /* Avión y trayecto móvil (oculto en desktop) */
  .flight-track-mobile-b {
    display: none;
  }

  /* Capas Decorativas (Montañas V2) */
  .video-grid__mountain {
    position: absolute;
    bottom: 0;
    z-index: 2;
    pointer-events: none;
  }

  .video-grid__mountain img {
    height: 100%;
    width: auto;
    display: block;
    user-select: none;
  }

  .video-grid__mountain--left {
    left: 0;
    height: clamp(380px, 45vw, 680px);
    opacity: 0.95;
  }

  .video-grid__mountain--right {
    right: 0;
    height: clamp(360px, 42vw, 650px);
    opacity: 0.95;
  }

  /* Responsive Design Móvil (Requerimiento 2: Layout final de Landing Page en móvil) */
  @media (max-width: 900px) {
    .video-grid {
      padding-top: 20px;
      padding-bottom: 120px;
    }

    .video-grid__container--desktop {
      display: none;
    }

    .video-grid__container--mobile {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
      width: min(90%, 360px);
      margin: 0 auto;
      text-align: center;
      position: relative;
      z-index: 5;
    }

    .video-grid__mobile-box {
      width: 100%;
      height: 77px;
      border-radius: 12px;
      overflow: hidden;
      background-color: #000000;
      border: none;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25);
    }

    .video-grid__mobile-header {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }

    .video-grid__mobile-header .video-grid__title {
      font-size: 1.65rem;
      line-height: 1.25;
    }

    .video-grid__mobile-header .video-grid__subtitle {
      font-size: 1.05rem;
    }

    .video-grid__mobile-desc p {
      font-size: 0.95rem;
      line-height: 1.55;
      color: rgba(255, 255, 255, 0.92);
      margin: 0;
    }

    .video-grid__cta-group {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
    }

    .video-grid__cta-group .btn-cta {
      width: 100%;
      max-width: 280px;
      padding: 12px 20px;
      font-size: 1rem;
    }

    /* Avión y Trayecto en Móvil (Figma Landing Page V2 Mobile) */
    .flight-track-mobile-b {
      display: block;
      width: min(100%, 340px);
      margin: -25px auto 0 auto;
      position: relative;
      pointer-events: none;
      z-index: 6;
    }

    .flight-track-mobile-b__img {
      width: 100%;
      height: auto;
      display: block;
      filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.25));
    }

    .video-grid__mountain {
      display: none;
    }
  }
</style>