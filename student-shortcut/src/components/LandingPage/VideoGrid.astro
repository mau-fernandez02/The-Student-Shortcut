---
// src/components/VideoGrid.astro

/* Interfaz para definir el contenido del componente */
interface VideoItem {
  id: string;
  src: string;
  type?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  paragraphs?: string[];
  ctaText?: string;
  ctaLink?: string;
  videos?: VideoItem[];
}

const {
  title = "¡Cualquier sueño es posible si lo hacemos Juntos!",
  subtitle = "Tu apuntas, ¡Y nosotros nos encargamos!",
  paragraphs = [
    "El equipo de The Student Shortcut te acompaña en todo el proceso para que puedas disfrutar de tu Experiencia de Intercambio.",
    "Te asesoramos a lo largo de tu postulación para asegurar la mejor compatibilidad entre tú y tu destino.",
    "Nosotros nos encargamos de encontrar la mejor familia anfitriona para ti. Te ayudamos con el idioma para que la transición sea más sencilla.",
    "Simplificamos la relación entre colegios locales y extranjeros para la validación de materias y notas."
  ],
  ctaText = "Inicia tu intercambio",
  ctaLink = "#nosotros",
  videos = [
    { id: "box-1", src: "/media/Vid-00001.webm", type: "video/webm" },
    { id: "box-2", src: "/media/Vid-00001.webm", type: "video/webm" },
    { id: "box-3", src: "/media/Vid-00001.webm", type: "video/webm" },
    { id: "box-4", src: "/media/Vid-00001.webm", type: "video/webm" },
    { id: "box-5", src: "/media/Vid-00001.webm", type: "video/webm" },
  ]
} = Astro.props;
---

<section class="video-grid">
  <div class="video-grid__container">
    
    <!-- Mosaico / Grid de Vídeos -->
    <div class="video-grid__subgrid">
      {videos.map((video) => (
        <div class={`video-grid__item video-grid__item--${video.id}`}>
          <video autoplay loop muted playsinline class="video-grid__video">
            <source src={video.src} type={video.type || "video/mp4"} />
          </video>
        </div>
      ))}
    </div>

    <!-- Bloque Informativo del Video Grid -->
    <div class="video-grid__content">
      <h1 class="video-grid__title">{title}</h1>
      <h2 class="video-grid__subtitle">{subtitle}</h2>
      
      <div class="video-grid__description">
        {paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <div class="video-grid__cta-group">
        <a href={ctaLink} class="btn btn-secondary">
          {ctaText}
        </a>
      </div>
    </div>

  </div>

  <!-- Capas Decorativas (Montañas) -->
  <div class="video-grid__mountain video-grid__mountain--left" aria-hidden="true">
    <img src="/img/SVG/Montaña_5.svg" alt="" />
  </div>
  <div class="video-grid__mountain video-grid__mountain--right" aria-hidden="true">
    <img src="/img/SVG/Montaña_2.svg" alt="" />
  </div>
</section>

<style>
  /* Contenedor Principal */
  .video-grid {
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  /* Grid General: Vídeos a la izquierda, Texto a la derecha */
  .video-grid__container {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(300px, 440px) 1fr;
    justify-content: center;
    gap: 45px;
    align-items: center;
    max-width: 1200px;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    padding-top: 20px;
    padding-bottom: clamp(120px, 20vw, 320px);
    padding-left: clamp(15px, 5vw, 40px);
    padding-right: clamp(15px, 5vw, 40px);
  }

  /* Disposición Asimétrica del Grid de Vídeos */
  .video-grid__subgrid {
    display: grid;
    grid-template-columns: 165px 74px 165px;
    grid-template-rows: 261px 261px 116px;
    gap: 20px;
    width: 100%;
    max-width: 448px;
  }

  .video-grid__item {
    position: relative;
    background-color: #121212;
    border-radius: 16px;
    overflow: hidden;
    width: 100%;
    height: 100%;
  }

  .video-grid__video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Posicionamiento por Filas */
  .video-grid__item--box-1 {
    grid-column: 1 / span 2;
  }

  .video-grid__item--box-2 {
    grid-column: 3;
  }

  .video-grid__item--box-3 {
    grid-column: 1;
  }

  .video-grid__item--box-4 {
    grid-column: 2 / span 2;
  }

  .video-grid__item--box-5 {
    grid-column: 1 / span 3;
  }

  /* Bloque Informativo */
  .video-grid__content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
    text-align: left;
    line-height: 1.6;
    color: #ffffff;
    text-shadow: 1.5px 1.5px 0px rgba(0, 0, 0, 0.2);
  }

  .video-grid__title {
    font-size: clamp(2rem, 4vw, 2.5rem);
    color: #ffffff;
    text-align: left;
  }

  .video-grid__subtitle {
    font-size: clamp(1.2rem, 2.5vw, 1.56rem);
    font-weight: 400;
    color: #ffffff;
  }

  .video-grid__description {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .video-grid__description p {
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    color: #ffffff;
  }

  .video-grid__cta-group {
    margin-top: 10px;
  }

  /* Elementos Decorativos (Montañas) */
  .video-grid__mountain {
    position: absolute;
    z-index: 1;
    pointer-events: none;
  }

  .video-grid__mountain img {
    height: 100%;
    display: block;
    user-select: none;
    pointer-events: none;
  }

  .video-grid__mountain--left {
    bottom: 50px;
    left: 0;
    height: 680px;
  }

  .video-grid__mountain--right {
    bottom: 120px;
    right: -20px;
    height: 600px;
    transform: rotateY(-180deg) scaleY(-1);
  }

  /* Adaptación Móvil */
  @media (max-width: 900px) {
    .video-grid__container {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .video-grid__subgrid {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: auto;
      max-width: 100%;
      height: auto;
    }

    .video-grid__mountain {
      display: none;
    }
  }
</style>