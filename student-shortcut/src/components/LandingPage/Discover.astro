---
// src/components/LandingPage/Discover.astro

interface Props {
  titlePrimary?: string;
  titleHighlight?: string;
  subtitle?: string;
  descriptionParagraph1?: string;
  descriptionParagraph2?: string;
  descriptionParagraph3?: string;
  videoSrcDesktop?: string;
  videoSrcMobile?: string;
}

const {
  titlePrimary = "Descubre tu potencial,",
  titleHighlight = "¡Explora el Mundo!",
  subtitle = "Desafía tus límites. Insértate en una cultura diferente y aprende.",
  descriptionParagraph1 = "Si estás leyendo esto, es porque sueñas alto. Lo único que te falta, es despegar.",
  descriptionParagraph2 = "¿Qué pasaría si te digo que estamos aquí para ayudarte a hacerlo?",
  descriptionParagraph3 = "The Student Shortcut te ofrece una ayuda completa para realizar tu intercambio en el extranjero.",
  videoSrcDesktop = "/media/VideoB-LandingPage.mp4",
  videoSrcMobile = "/media/Mobile/VideoB-LandingPage Mobile.mp4",
} = Astro.props;
---

<section class="discover">
  <div class="discover__container">
    <!-- Contenido Textual -->
    <div class="discover__content">
      <h2 class="discover__title" data-i18n-html="discover.title">
        {titlePrimary} <br />
        <span class="discover__title-highlight">{titleHighlight}</span>
      </h2>
      <p class="discover__subtitle" data-i18n="discover.subtitle">{subtitle}</p>
      <div class="discover__description">
        <p data-i18n="discover.p1">{descriptionParagraph1}</p>
        <p data-i18n="discover.p2">{descriptionParagraph2}</p>
        <p data-i18n="discover.p3">{descriptionParagraph3}</p>
      </div>
    </div>

    <!-- Video B (Desktop a la derecha, Móvil arriba) -->
    <div class="discover__video-wrapper">
      <video autoplay loop muted playsinline class="discover__video">
        <source src={videoSrcMobile} media="(max-width: 768px)" type="video/mp4" />
        <source src={videoSrcDesktop} type="video/mp4" />
        Tu navegador no soporta la reproducción de video.
      </video>
    </div>
  </div>

  <!-- Capas Decorativas de Nubes (Desktop) -->
  <div class="discover__cloud discover__cloud--left" aria-hidden="true">
    <img src="/img/SVG/Nube_9.svg" alt="" width="880" height="400" loading="lazy" />
  </div>
  <div class="discover__cloud discover__cloud--right" aria-hidden="true">
    <img src="/img/SVG/Nube_1.svg" alt="" width="500" height="300" loading="lazy" />
  </div>

  <!-- Nubes decorativas móvil al final de la sección (PDF 1 pág 2) -->
  <div class="discover__mobile-clouds" aria-hidden="true">
    <img src="/img/SVG/Nube_8.svg" class="cloud-m cloud-m--1" alt="" />
    <img src="/img/SVG/Nube_10.svg" class="cloud-m cloud-m--2" alt="" />
    <img src="/img/SVG/Nube_1.svg" class="cloud-m cloud-m--3" alt="" />
  </div>
</section>

<style>
  .discover {
    position: relative;
    overflow: hidden;
    width: 100%;
    padding: 60px 0 160px;
  }

  .discover__container {
    position: relative;
    z-index: 5;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 3.5rem;
    align-items: center;
    max-width: 1200px;
    width: min(88%, 1200px);
    margin: 0 auto;
  }

  .discover__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    text-align: left;
    color: #ffffff;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .discover__title {
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    color: #ffffff;
    margin: 0;
  }

  .discover__title-highlight {
    color: #ffffff;
    font-size: clamp(2.6rem, 4.5vw, 3.4rem);
  }

  .discover__subtitle {
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    font-weight: 600;
    line-height: 1.4;
    color: #ffffff;
    margin: 0;
  }

  .discover__description {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .discover__description p {
    font-size: clamp(0.98rem, 1.8vw, 1.15rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.95);
    margin: 0;
  }

  /* Bloque de Video */
  .discover__video-wrapper {
    width: 100%;
    max-width: 451px;
    aspect-ratio: 451 / 565;
    border-radius: 16px;
    overflow: hidden;
    background-color: #000000;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.25);
    border: 2px solid rgba(255, 255, 255, 0.35);
    justify-self: end;
  }

  .discover__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Capas Decorativas (Nubes Desktop) */
  .discover__cloud {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    user-select: none;
  }

  .discover__cloud img {
    width: 100%;
    height: auto;
    display: block;
  }

  .discover__cloud--left {
    bottom: -80px;
    left: -260px;
    width: min(880px, 60vw);
    transform: rotate(-185deg) rotateX(-180deg);
    opacity: 0.9;
  }

  .discover__cloud--right {
    bottom: -60px;
    right: -120px;
    width: min(500px, 45vw);
    opacity: 0.9;
  }

  .discover__mobile-clouds {
    display: none;
  }

  /* Responsive Design Móvil (Requerimiento 2: Layout final de Landing Page en móvil) */
  @media (max-width: 860px) {
    .discover {
      padding: 40px 0 100px;
    }

    .discover__container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2rem;
    }

    /* En móvil: Video B primero arriba, textos abajo (PDF 1 pág 2) */
    .discover__video-wrapper {
      order: 1;
      width: min(100%, 295px);
      aspect-ratio: 295 / 370;
      margin: 0 auto;
      justify-self: center;
    }

    .discover__content {
      order: 2;
      align-items: center;
      text-align: center;
      gap: 1.2rem;
    }

    .discover__title {
      font-size: clamp(1.8rem, 5.5vw, 2.3rem);
    }

    .discover__title-highlight {
      font-size: clamp(2.1rem, 6vw, 2.6rem);
    }

    .discover__subtitle {
      font-size: 1.1rem;
    }

    .discover__description p {
      font-size: 0.95rem;
    }

    .discover__cloud {
      display: none;
    }

    /* Nubes agrupadas en móvil al fondo de la sección */
    .discover__mobile-clouds {
      display: block;
      position: absolute;
      bottom: -30px;
      left: 0;
      width: 100%;
      height: 90px;
      pointer-events: none;
      overflow: hidden;
      z-index: 3;
    }

    .cloud-m {
      position: absolute;
      height: auto;
      opacity: 0.85;
    }

    .cloud-m--1 {
      left: -40px;
      bottom: -15px;
      width: 180px;
    }

    .cloud-m--2 {
      left: 45%;
      bottom: -20px;
      width: 220px;
      transform: translateX(-50%);
    }

    .cloud-m--3 {
      right: -30px;
      bottom: -10px;
      width: 160px;
    }
  }
</style>