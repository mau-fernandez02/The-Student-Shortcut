---
// Footer
---

<footer class="site-footer">
  <div class="footer-container">
    <!-- Izquierda: Logo o Descripción -->
    <div class="footer-left">
      <a href="#" class="footer-logo">
        <img src="/img/LogoWhite_V2.png" alt="Student Shortcut" />
      </a>
      <p class="footer-description">¡Despega, Descubre, Destaca!</p>
    </div>

    <!-- Medio: Navegación -->
    <div class="footer-middle">
      <h4>Navegación</h4>
      <nav>
        <ul class="links-list">
          <li class="link-item">
            <a href="/programas">Programas</a>
          </li>
          <li class="link-item">
            <a href="/contactanos">Contacto</a>
          </li>
          <li class="link-item">
            <a href="/irse-intercambio">Ubicación</a>
          </li>
          <li class="link-item">
            <a href="/quienes-somos">Nosotros</a>
          </li>
        </ul>
      </nav>
    </div>

    <!-- Derecha: Redes -->
    <!-- Derecha: Redes -->
    <div class="footer-right">
      <h4>Redes</h4>
      <div class="social-icons">
        <a href="#facebook" class="social-btn" aria-label="Facebook">
          <img
            src="/img/icons/facebook.svg"
            alt="página de facebook"
            class="icon-img"
          />
        </a>
        <a href="#instagram" class="social-btn" aria-label="Instagram">
          <img src="/img/icons/instagram.svg" alt="" class="icon-img" />
        </a>
        <a href="#tiktok" class="social-btn" aria-label="TikTok">
          <img
            src="/img/icons/tiktok.svg"
            alt="página de tik tok"
            class="icon-img"
          />
        </a>
      </div>
    </div>
  </div>

  <!-- Barra inferior de Copyright -->
  <div class="footer-bottom">
    <p>&copy; 2026 The Student Shortcut. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  /* Estructura principal del footer */
  .site-footer {
    z-index: 15;
    background-color: var(
      --color-primary,
      #121212
    ); /* Fallback a gris muy oscuro si la variable falla */
    color: #ffffff;
    padding: 50px 0 20px; /* Espaciado interno: arriba, lados, abajo */
    font-family: sans-serif;
  }

  .footer-container {
    display: flex;
    flex-wrap: wrap; /* Permite que los elementos salten de línea si no caben */
    justify-content: space-between;
    gap: 40px;
    max-width: 1200px; /* Ancho máximo para monitores grandes */
    margin: 0 auto; /* Centra el contenedor */
    padding: 0 20px;
  }

  /* Comportamiento de las columnas */
  .footer-left,
  .footer-middle,
  .footer-right {
    flex: 1; /* Hacen que las columnas ocupen el mismo ancho */
    min-width: 200px; /* Evita que las columnas se aplasten demasiado */
  }

  /* Estilos de la columna izquierda (Logo y texto) */
  .footer-logo {
    font-size: 1.8rem;
    font-weight: bold;
    color: #ffffff;
    text-decoration: none;
    display: inline-block;
    margin-bottom: 15px;
  }

  .footer-description {
    color: #ffffff; /* Gris claro para texto secundario */
    line-height: 1.6;
  }

  /* Títulos de las columnas */
  .footer-middle h4,
  .footer-right h4 {
    font-size: 1.1rem;
    margin-bottom: 20px;
    color: #ffffff;
  }

  /* Lista de enlaces */
  .links-list {
    list-style: none; /* Quita los puntos de la lista */
    padding: 0px 0px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    
    gap: 0px; /* Separación vertical entre enlaces */
  }

  .links-list a {
    color: #e9e9e9;
    font-size: 1rem;
    display: flex; /* ← ESTO ACTIVA LA ANIMACIÓN */
    border-left: 1px solid rgba(255, 255, 255, 0.164);
    
    padding: 5px 10px;
    transition: transform 0.4s ease;
  }

  .links-list a:hover {
    transform: translateX(2px);
    color: #ffffff;
    font-weight: bold;
    border-left: 3px solid rgb(255, 255, 255);
  }

  /* Botones de Redes Sociales */
  .social-icons {
    display: flex;
    gap: 15px;
  }

  .social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background-color: transparent;

    border-radius: 50%;

    text-decoration: none;
    transition:
      background-color 0.3s ease,
      transform 0.3s ease;
  }

  .social-btn:hover {
    background-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-3px);
  }

  /* NUEVO: Controlamos el tamaño del icono */
  .icon-img {
    width: 100%; /* Ajusta este valor si los quieres más grandes o pequeños */
    height: 100%;
    object-fit: cover; /* Evita que la imagen se deforme */
  }

  /* Barra inferior de Copyright */
  .footer-bottom {
    margin-top: 60px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1); /* Línea divisoria muy sutil */
    text-align: center;
    color: #ffffff;
    font-size: 0.9rem;
  }

  /* Diseño Responsivo (Celulares) */
  @media (max-width: 768px) {
    .footer-container {
      flex-direction: column; /* Apila las columnas una debajo de otra */
      text-align: center; /* Centra todo el texto */
    }
    .social-icons {
      justify-content: center; /* Centra los botones de redes */
    }
  }
</style>
