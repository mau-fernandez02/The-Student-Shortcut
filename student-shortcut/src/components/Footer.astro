---
// src/components/Footer.astro

interface NavLink {
  label: string;
  href: string;
}

interface SocialLink {
  name: string;
  href: string;
  icon: string;
}

interface Props {
  brandDescription?: string;
  logoSrc?: string;
}

const {
  brandDescription = "¡Despega, Descubre, Destaca!",
  logoSrc = "/img/LogoWhite_V2.png",
} = Astro.props;

const currentYear = new Date().getFullYear();

const navLinks: NavLink[] = [
  { label: "Programas", href: "/programas" },
  { label: "Contacto", href: "/contactanos" },
  { label: "Irse de Intercambio", href: "/irse-intercambio" },
  { label: "Nosotros", href: "/quienes-somos" },
];

const socialLinks: SocialLink[] = [
  { name: "Facebook", href: "https://facebook.com", icon: "/img/icons/facebook.svg" },
  { name: "Instagram", href: "https://instagram.com", icon: "/img/icons/instagram.svg" },
  { name: "TikTok", href: "https://tiktok.com", icon: "/img/icons/tiktok.svg" },
];
---

<footer class="footer">
  <div class="footer__container">
    <!-- Marca y Descripción -->
    <div class="footer__brand">
      <a href="/" class="footer__logo-link">
        <img
          src={logoSrc}
          alt="Student Shortcut Logo"
          class="footer__logo-img"
          width="180"
          height="50"
          loading="lazy"
        />
      </a>
      <p class="footer__description">{brandDescription}</p>
    </div>

    <!-- Navegación Principal -->
    <div class="footer__nav">
      <h3 class="footer__heading">Navegación</h3>
      <nav aria-label="Navegación a pie de página">
        <ul class="footer__links">
          {
            navLinks.map((link) => (
              <li class="footer__link-item">
                <a href={link.href} class="footer__link">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <!-- Redes Sociales -->
    <div class="footer__social">
      <h3 class="footer__heading">Síguenos</h3>
      <div class="footer__social-list">
        {
          socialLinks.map((social) => (
            <a
              href={social.href}
              class="footer__social-btn"
              aria-label={`Visita nuestro perfil de ${social.name}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src={social.icon}
                alt=""
                class="footer__social-icon"
                width="24"
                height="24"
                loading="lazy"
              />
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Barra de Derechos Reservados -->
  <div class="footer__bottom">
    <p class="footer__copyright">
      &copy; {currentYear} The Student Shortcut. Todos los derechos reservados.
    </p>
  </div>
</footer>

<style>
  /* Contenedor Principal */
  .footer {
    position: relative;
    z-index: 15;
    background-color: var(--color-primary, #121212);
    color: #ffffff;
    padding: 60px 0 20px;
    font-family: inherit;
    width: 100%;
  }

  .footer__container {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Columnas Flexibles */
  .footer__brand,
  .footer__nav,
  .footer__social {
    flex: 1;
    min-width: 220px;
  }

  /* Columna Marca */
  .footer__logo-link {
    display: inline-block;
    margin-bottom: 16px;
    transition: opacity 0.3s ease;
  }

  .footer__logo-link:hover {
    opacity: 0.75;
  }

  .footer__logo-img {
    min-width: 220px;
    height: auto;
    object-fit: contain;
  }

  .footer__description {
    color: #fcfdff;
    font-size: 1rem;
    line-height: 1.5;
    margin: 0;
  }

  /* Encabezados de Sección */
  .footer__heading {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 20px;
    color: #ffffff;
  }

  /* Enlaces de Navegación */
  .footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .footer__link {
    color: #e5e7eb;
    font-size: 0.95rem;
    display: inline-block;
    padding: 6px 12px;
    border-left: 2px solid rgba(255, 255, 255, 0.15);
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .footer__link:hover,
  .footer__link:focus-visible {
    transform: translateX(4px);
    color: #ffffff;
    border-left-color: #09c6ff;
    font-weight: 500;
  }

  /* Redes Sociales */
  .footer__social-list {
    display: flex;
    gap: 12px;
  }

  .footer__social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .footer__social-btn:hover,
  .footer__social-btn:focus-visible {
    background-color: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-3px);
  }

  .footer__social-icon {
    width: 22px;
    height: 22px;
    object-fit: contain;
  }

  /* Barra de Copyright Inferior */
  .footer__bottom {
    margin-top: 50px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
  }

  .footer__copyright {
    color: #fcfdff;
    font-size: 0.875rem;
    margin: 0;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .footer__container {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 32px;
    }

    .footer__links {
      align-items: center;
    }

    .footer__link {
      border-left: none;
      border-bottom: 2px solid transparent;
    }

    .footer__link:hover,
    .footer__link:focus-visible {
      transform: translateY(-2px);
      border-left-color: transparent;
      border-bottom-color: #09c6ff;
    }

    .footer__social-list {
      justify-content: center;
    }
  }
</style>