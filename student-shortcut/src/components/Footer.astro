---
// src/components/Footer.astro

interface NavLink {
  key: string;
  label: string;
  href: string;
}

interface SocialLink {
  name: string;
  href: string;
  icon: string;
}

interface Props {
  brandDescription?: string;
  logoSrc?: string;
}

const {
  brandDescription = "¡Despega, descubre, destaca!",
  logoSrc = "/img/SVG/StudentShortcut-LogoWhite_V2.svg",
} = Astro.props;

const navLinks: NavLink[] = [
  { key: "footer.programs", label: "Programas", href: "/programas" },
  { key: "footer.exchange", label: "¿Qué es un intercambio?", href: "/irse-intercambio" },
  { key: "footer.about", label: "¿Quiénes somos?", href: "/quienes-somos" },
  { key: "footer.contact", label: "Contacto", href: "/contactanos" },
];

const socialLinks: SocialLink[] = [
  { name: "Instagram", href: "https://instagram.com/student.shortcut.bo", icon: "/img/SVG/instagram-svgrepo-com.svg" },
  { name: "Facebook", href: "https://facebook.com/student.shortcut.bo", icon: "/img/SVG/facebook-svgrepo-com.svg" },
  { name: "TikTok", href: "https://tiktok.com/@student.shortcut.bo", icon: "/img/SVG/tiktok-svgrepo-com.svg" },
];
---

<footer class="footer">
  <div class="footer__container">
    <!-- Marca y Slogan (Figma PDF 1 pág 11) -->
    <div class="footer__brand">
      <a href="/" class="footer__logo-link" aria-label="Ir al inicio">
        <img
          src={logoSrc}
          alt="Student Shortcut Logo"
          class="footer__logo-img"
          width="190"
          height="52"
          loading="lazy"
        />
      </a>
      <p class="footer__description" data-i18n="footer.slogan">{brandDescription}</p>
    </div>

    <!-- Navegación Principal -->
    <div class="footer__nav">
      <ul class="footer__links">
        {
          navLinks.map((link) => (
            <li class="footer__link-item">
              <a href={link.href} class="footer__link" data-i18n={link.key}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Redes Sociales -->
    <div class="footer__social">
      <h3 class="footer__heading" data-i18n="footer.followUs">Redes</h3>
      <div class="footer__social-list">
        {
          socialLinks.map((social) => (
            <a
              href={social.href}
              class="footer__social-btn"
              aria-label={`Visita nuestro perfil de ${social.name}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src={social.icon}
                alt={social.name}
                class="footer__social-icon"
                width="22"
                height="22"
                loading="lazy"
              />
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Barra de Derechos Reservados -->
  <div class="footer__bottom">
    <p class="footer__copyright" data-i18n="footer.copyright">
      Todos los derechos reservados por THE STUDENT SHORTCUT © 2026
    </p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 15;
    background-color: #1e9cd7;
    color: #ffffff;
    padding: 55px 0 25px;
    width: 100%;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .footer__container {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 200px;
  }

  .footer__logo-img {
    width: auto;
    height: 48px;
    max-width: 200px;
    object-fit: contain;
  }

  .footer__description {
    color: #ffffff;
    font-size: 0.95rem;
    font-style: italic;
    opacity: 0.92;
    margin: 0;
  }

  /* Enlaces de Navegación */
  .footer__nav {
    display: flex;
    align-items: center;
  }

  .footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 2.2rem;
  }

  .footer__link {
    color: #ffffff;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .footer__link:hover {
    opacity: 0.8;
    transform: translateY(-1px);
  }

  /* Redes Sociales */
  .footer__social {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .footer__heading {
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .footer__social-list {
    display: flex;
    gap: 10px;
  }

  .footer__social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background-color: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .footer__social-btn:hover {
    background-color: #ffffff;
    transform: translateY(-2px);
  }

  .footer__social-btn:hover .footer__social-icon {
    filter: invert(1);
  }

  .footer__social-icon {
    width: 20px;
    height: 20px;
    object-fit: contain;
    filter: brightness(0) invert(1);
    transition: filter 0.25s ease;
  }

  /* Copyright */
  .footer__bottom {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    text-align: center;
  }

  .footer__copyright {
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.85rem;
    margin: 0;
  }

  /* Mobile */
  @media (max-width: 860px) {
    .footer__container {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 24px;
    }

    .footer__links {
      flex-direction: column;
      gap: 12px;
      align-items: center;
    }
  }
</style>