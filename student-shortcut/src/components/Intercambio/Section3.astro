---
// src/components/Intercambio/Section3.astro

interface StepItem {
  iconSrc: string;
  iconAlt: string;
  key: string;
  description: string;
}

const steps: StepItem[] = [
  {
    iconSrc: "/img/SVG/study-2-svgrepo-com.svg",
    iconAlt: "Icono de documentación académica",
    key: "exchange.sec3.step1",
    description: "Gestión Académica: Organización y validación de documentación académica para garantizar una transición óptima."
  },
  {
    iconSrc: "/img/SVG/world-1-svgrepo-com.svg",
    iconAlt: "Icono de alcance global",
    key: "exchange.sec3.step2",
    description: "Soporte Global: Asistencia continua en el extranjero de la mano de nuestros Partners certificados."
  },
  {
    iconSrc: "/img/SVG/passport-1-svgrepo-com.svg",
    iconAlt: "Icono de pasaporte y visado",
    key: "exchange.sec3.step3",
    description: "Visados y Documentación: Orientación paso a paso en la preparación de pasaportes y visados correspondientes."
  }
];
---

<section class="exchange-process">
  <div class="exchange-process__container">
    <!-- Encabezado de la Sección -->
    <header class="exchange-process__header">
      <h2 class="exchange-process__title" data-i18n="exchange.sec3.title">¿Cómo irse de intercambio?</h2>
      <p class="exchange-process__subtitle" data-i18n="exchange.sec3.subtitle">
        Dar el paso hacia un intercambio puede parecer un desafío logístico, pero
        con nosotros el proceso se convierte en un camino claro y seguro:
      </p>
    </header>

    <!-- Lista de Pasos / Tarjetas -->
    <div class="exchange-process__grid">
      {
        steps.map((step) => (
          <article class="process-card">
            <div class="process-card__icon-wrapper">
              <img
                src={step.iconSrc}
                alt={step.iconAlt}
                class="process-card__icon"
                width="80"
                height="80"
                loading="lazy"
              />
            </div>
            <p class="process-card__description" data-i18n={step.key}>{step.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .exchange-process {
    width: 100%;
    padding: 70px 0;
    color: #ffffff;
    position: relative;
    z-index: 5;
  }

  .exchange-process__container {
    width: min(90%, 1020px);
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3.5rem;
  }

  /* Header */
  .exchange-process__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
    text-align: center;
    max-width: 820px;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .exchange-process__title {
    font-size: clamp(2rem, 4vw, 2.7rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    line-height: 1.2;
  }

  .exchange-process__subtitle {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    font-weight: 400;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.95);
    margin: 0;
  }

  /* Grid de Pasos */
  .exchange-process__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    width: 100%;
  }

  /* Tarjeta Individual */
  .process-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
    text-align: center;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 20px;
    padding: 32px 20px;
    backdrop-filter: blur(10px);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.15);
    transition: transform 0.3s ease, background 0.3s ease;
  }

  .process-card:hover {
    transform: translateY(-5px);
    background: rgba(255, 255, 255, 0.16);
  }

  /* Círculo del Icono */
  .process-card__icon-wrapper {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background-color: #ffffff;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.18);
  }

  .process-card__icon {
    width: 58px;
    height: 58px;
    object-fit: contain;
  }

  .process-card__description {
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.6;
    color: #ffffff;
    margin: 0;
  }

  @media (max-width: 860px) {
    .exchange-process__grid {
      grid-template-columns: 1fr;
      max-width: 380px;
      margin: 0 auto;
    }
  }
</style>