---
// src/components/IrseIntercambio/PerfilPostulante.astro

interface Props {
  videoSrc?: string;
  videoType?: string;
}

const {
  videoSrc = "/media/#",
  videoType = "video/mp4"
} = Astro.props;
---

<section class="applicant-profile">
  <div class="applicant-profile__container">
    <!-- Media / Video B (Cuadrado 1:1) -->
    <div class="applicant-profile__media">
      <div class="applicant-profile__video-wrapper">
        <video
          autoplay
          loop
          muted
          playsinline
          class="applicant-profile__video"
        >
          <source src={videoSrc} type={videoType} />
          Tu navegador no soporta la reproducción de video.
        </video>
      </div>
    </div>

    <!-- Información y Contenido -->
    <div class="applicant-profile__content">
      <header class="applicant-profile__header">
        <h2 class="applicant-profile__title">
          ¿Quiénes pueden postular a los programas?
        </h2>
      </header>

      <div class="applicant-profile__description">
        <p>
          Nuestro programa está abierto a jóvenes de secundaria entre 14 y 18 años
          que dominen las bases del idioma correspondiente.
        </p>
        <p>
          Más allá de cumplir con el perfil académico y lingüístico, buscamos a
          estudiantes apasionados por el mundo con una gran voluntad de compartir
          sus propias culturas y descubrir otra.
        </p>
      </div>

      <div class="applicant-profile__actions">
        <a href="/programas" class="applicant-profile__btn">
          Conoce los programas
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .applicant-profile {
    width: 100%;
    padding: 60px 0;
    color: #ffffff;
  }

  .applicant-profile__container {
    width: min(100%, 920px);
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 2.5rem;
  }

  /* Video (Proporción 1:1 estricta) */
  .applicant-profile__media {
    flex: 1;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .applicant-profile__video-wrapper {
    position: relative;
    width: 100%;
    max-width: 440px;
    aspect-ratio: 1 / 1;
    border-radius: 16px;
    overflow: hidden;
    background-color: #000000;
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .applicant-profile__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Columna de Texto */
  .applicant-profile__content {
    flex: 1.2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .applicant-profile__title {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    line-height: 1.3;
    color: #ffffff;
    margin: 0;
  }

  .applicant-profile__description {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .applicant-profile__description p {
    font-size: clamp(0.95rem, 1.8vw, 1.05rem);
    font-weight: 300;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.92);
    margin: 0;
  }

  /* Botón estilizado */
  .applicant-profile__actions {
    margin-top: 0.5rem;
  }

  .applicant-profile__btn {
    display: inline-block;
    padding: 12px 28px;
    color: #ffffff;
    background-color: transparent;
    border: 1px solid #ffffff;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    text-align: center;
    transition: all 0.3s ease;
  }

  .applicant-profile__btn:hover {
    background-color: #ffffff;
    color: #000000;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(255, 255, 255, 0.2);
  }

  /* Adaptabilidad Móvil */
  @media (max-width: 768px) {
    .applicant-profile {
      padding: 40px 0;
    }

    .applicant-profile__container {
      flex-direction: column;
      gap: 2rem;
    }

    .applicant-profile__content {
      align-items: center;
      text-align: center;
    }

    .applicant-profile__video-wrapper {
      max-width: 320px;
      /* Mantiene la relación de aspecto 1:1 en pantallas pequeñas */
      aspect-ratio: 1 / 1;
    }

    .applicant-profile__btn {
      width: 100%;
      max-width: 280px;
    }
  }
</style>