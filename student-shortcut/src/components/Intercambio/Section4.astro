<style>
  .sec-4 {
    max-width: min(85%, 1100px);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 40px;
    padding: 60px 0px;
  }

  .layout-videos-D-C-E {
    display: grid;
    /* Proporción correcta: 115px : 450px : 115px = 1fr : 3.913fr : 1fr */
    grid-template-columns: 1fr 3.913fr 1fr;
    gap: clamp(16px, 3vw, 28px);
    width: 100%;
    max-width: clamp(280px, 90vw, 1200px);
  }

  /* Videos laterales: 115px x 450px = aspect-ratio 115/450 */
  .box-video-1 {
    width: 100%;
    aspect-ratio: 115 / 450;
    background-color: black;
    overflow: hidden;
    border-radius: 8px;
  }

  /* Video central: 450px x 450px = aspect-ratio 1/1 */
  .box-video-2 {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: black;
    overflow: hidden;
    border-radius: 8px;
  }

  .video-holder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sec-4-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 20px;
    max-width: 1200px;
    width: 100%;
  }

  .sec-4-text h1 {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
  }

  .sec-4-text p {
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    line-height: 1.6;
  }

  /* Responsivo para pantallas medianas */
  @media (max-width: 768px) {
    .layout-videos-D-C-E {
      grid-template-columns: 0.5fr 2fr 0.5fr;
      gap: clamp(12px, 2vw, 20px);
      max-width: 100%;
    }

    .box-video-1 {
      aspect-ratio: 115 / 450;
    }

    .box-video-2 {
      aspect-ratio: 1 / 1;
    }
  }

  /* Responsivo para pantallas pequeñas */
  @media (max-width: 480px) {
    .layout-videos-D-C-E {
      grid-template-columns: 1fr;
      gap: 12px;
      max-width: 100%;
    }

    .box-video-1:nth-child(1),
    .box-video-1:nth-child(3) {
      display: none;
    }

    .box-video-2 {
      aspect-ratio: 1 / 1;
      max-width: 280px;
    }
  }
</style>