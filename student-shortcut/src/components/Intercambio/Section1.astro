---
// src/components/Intercambio/Section1.astro

interface Props {
  videoSrc?: string;
  videoType?: string;
}

const {
  videoSrc = "/media/VideoA-Intercambio.mp4",
  videoType = "video/mp4",
} = Astro.props;
---

<section class="exchange-hero">
  <!-- Decoración nubes de Fondo (PDF 1 pág 5) -->
  <div class="exchange-hero__cloud cloud__left--middle" aria-hidden="true">
    <img src="/img/SVG/Nube_14.svg" alt="" width="800" height="400" loading="eager" />
  </div>
  <div class="exchange-hero__cloud cloud__left--front" aria-hidden="true">
    <img src="/img/SVG/Nube_13.svg" alt="" width="800" height="400" loading="eager" />
  </div>
  <div class="exchange-hero__cloud cloud__right--front" aria-hidden="true">
    <img src="/img/SVG/Nube_10.svg" alt="" width="800" height="400" loading="eager" />
  </div>
  <div class="exchange-hero__cloud cloud__right--back" aria-hidden="true">
    <img src="/img/SVG/Nube_11.svg" alt="" width="800" height="400" loading="eager" />
  </div>

  <div class="exchange-hero__container">
    <!-- Banner de Video A -->
    <div class="exchange-hero__media">
      <div class="exchange-hero__video-wrapper">
        <video autoplay loop muted playsinline class="exchange-hero__video">
          <source src="/media/Mobile/VideoA-Intercambio-Mobile.mp4" media="(max-width: 768px)" type="video/mp4" />
          <source src={videoSrc} type={videoType} />
          Tu navegador no soporta la reproducción de video.
        </video>
      </div>
    </div>

    <!-- Contenido Textual -->
    <header class="exchange-hero__header">
      <h1 class="exchange-hero__title" data-i18n="exchange.sec1.title">
        Imagínate estudiar en un colegio extranjero, mientras absorbes un nuevo
        idioma y te sumerges en una nueva cultura.
      </h1>
    </header>

    <div class="exchange-hero__description">
      <p data-i18n="exchange.sec1.p1">
        Un intercambio es una inmersión total en un sistema educativo extranjero, diseñado para descubrir nuevas competencias lingüísticas y conectar profundamente con una cultura diferente. Con opciones flexibles de 5 a 10 meses, el programa combina la excelencia académica con una experiencia humana irrepetible.
      </p>
      <p data-i18n="exchange.sec1.p2">
        Durante tu estancia tienes la oportunidad de crecer diariamente con una familia anfitriona que te acoge como un miembro más.
      </p>
      <p data-i18n="exchange.sec1.p3">
        Esto es más que un viaje... Es una experiencia que te permitirá desafiar tus propios límites y construir una versión renovada de ti mismo que perdurará para siempre.
      </p>
    </div>

    <div class="exchange-hero__actions">
      <a href="/programas" class="exchange-hero__btn" data-i18n="exchange.sec1.btn">
        Descubre nuestros programas
      </a>
    </div>
  </div>
</section>

<style>
  .exchange-hero {
    padding: 110px 0 60px 0;
    color: #ffffff;
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  .exchange-hero__container {
    width: min(90%, 960px);
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    gap: 2.2rem;
    position: relative;
    z-index: 5;
  }

  /* Banner de Video */
  .exchange-hero__media {
    width: 100%;
  }

  .exchange-hero__video-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 8 / 3;
    border-radius: 18px;
    overflow: hidden;
    background-color: #000000;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.28);
    border: none;
  }

  .exchange-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .exchange-hero__title {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 800;
    line-height: 1.25;
    color: #ffffff;
    margin: 0;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .exchange-hero__description {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .exchange-hero__description p {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    font-weight: 400;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.95);
    margin: 0;
  }

  .exchange-hero__actions {
    margin-top: 0.5rem;
  }

  .exchange-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 32px;
    border-radius: 50px;
    background-color: transparent;
    color: #ffffff;
    border: 2px solid #ffffff;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
  }

  .exchange-hero__btn:hover {
    background-color: #ffffff;
    color: #005b97;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.25);
  }

  /* Elementos Decorativos */
  .exchange-hero__cloud {
    position: absolute;
    z-index: 1;
    pointer-events: none;
    user-select: none;
  }

  .exchange-hero__cloud img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .cloud__left--front {
    top: 130px;
    left: -200px;
    width: min(700px, 45vw);
    transform: scaleX(-1);
    opacity: 0.9;
  }

  .cloud__left--middle {
    top: 110px;
    left: -60px;
    width: min(650px, 40vw);
    transform: scaleX(-1);
    opacity: 0.85;
  }

  .cloud__right--back {
    top: 120px;
    right: -120px;
    width: min(650px, 40vw);
    opacity: 0.85;
  }

  .cloud__right--front {
    top: 150px;
    right: -80px;
    width: min(650px, 40vw);
    opacity: 0.9;
  }

  @media (max-width: 860px) {
    .exchange-hero {
      padding: 90px 0 40px 0;
    }

    .exchange-hero__container {
      gap: 1.5rem;
      text-align: center;
    }

    .exchange-hero__actions {
      display: flex;
      justify-content: center;
    }

    .exchange-hero__btn {
      width: 100%;
      max-width: 280px;
    }

    .exchange-hero__video-wrapper {
      aspect-ratio: 16 / 10;
      border-radius: 14px;
    }

    .exchange-hero__cloud {
      display: none;
    }
  }
</style>
