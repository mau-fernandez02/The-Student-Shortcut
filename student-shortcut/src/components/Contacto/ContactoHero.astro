---
// src/components/Contacto/ContactoHero.astro

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "¡Contáctanos!",
  subtitle = "Estamos aquí para resolver tus dudas y ayudarte a dar el primer paso hacia tu experiencia de intercambio."
} = Astro.props;
---

<header class="contact-hero">
  <div class="contact-hero__container">
    <h1 class="contact-hero__title">{title}</h1>
    <p class="contact-hero__subtitle">{subtitle}</p>
  </div>
</header>

<style>
  .contact-hero {
    width: 100%;
    padding: 60px 0 20px;
    color: #ffffff;
    text-align: center;
  }

  .contact-hero__container {
    width: min(100%, 800px);
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }

  .contact-hero__title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.2;
    color: #ffffff;
    margin: 0;
  }

  .contact-hero__subtitle {
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 400;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
  }
</style>