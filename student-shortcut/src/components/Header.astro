---
// src/components/Header.astro

interface NavItem {
  key: string;
  labelEs: string;
  labelEn: string;
  href: string;
}

interface Props {
  logoSrc?: string;
}

const { logoSrc = "/img/SVG/StudentShortcut-LogoBlack_V2.svg" } = Astro.props;

const navItems: NavItem[] = [
  { key: "nav.programs", labelEs: "Programas", labelEn: "Programs", href: "/programas" },
  { key: "nav.about", labelEs: "Nosotros", labelEn: "About Us", href: "/quienes-somos" },
  { key: "nav.exchange", labelEs: "Intercambio", labelEn: "Exchange", href: "/irse-intercambio" },
  { key: "nav.contact", labelEs: "Contacto", labelEn: "Contact", href: "/contactanos" },
];
---

<header class="header" id="mainHeader">
  <!-- BANNER SUPERIOR DE AVISO (DESKTOP) -->
  <div class="header__top-banner" id="headerTopBanner">
    <div class="header__top-banner-inner">
      <span data-i18n="header.announcement">El Calendario 2027 ya está abierto · ¡Agenda tu llamada!</span>
    </div>
  </div>

  <div class="header__container">
    <!-- LOGO -->
    <a href="/" class="header__logo-link" id="headerLogo" aria-label="Ir al inicio">
      <img
        src={logoSrc}
        alt="Student Shortcut Logo"
        class="header__logo-img"
        width="160"
        height="42"
        fetchpriority="high"
        decoding="sync"
      />
    </a>

    <!-- NAVEGACIÓN ESCRITORIO -->
    <nav class="header__nav" aria-label="Navegación principal">
      <ul class="header__nav-list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="header__nav-link" data-i18n={item.key}>
                {item.labelEs}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- ACCIONES EN ESCRITORIO -->
    <div class="header__actions">
      <!-- Selector de Idioma Escritorio (visible solo en desktop >991px) -->
      <div class="header__lang-selector header__lang-selector--desktop" id="langSelectorDesktop">
        <button
          class="header__lang-btn"
          id="langBtnDesktop"
          aria-label="Cambiar idioma"
          aria-haspopup="true"
          aria-expanded="false"
          type="button"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="header__icon-globe"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path
              d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
            ></path>
          </svg>
          <span class="header__lang-text">Español</span>
          <svg
            class="header__icon-chevron"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <div class="header__lang-dropdown">
          <button type="button" class="header__lang-option header__lang-option--active" data-lang="es">Español</button>
          <button type="button" class="header__lang-option" data-lang="en">English</button>
        </div>
      </div>

      <!-- Botón Menú Hamburguesa Móvil -->
      <button
        class="header__menu-toggle"
        id="menuToggle"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        type="button"
      >
        <span class="header__bar header__bar--1"></span>
        <span class="header__bar header__bar--2"></span>
        <span class="header__bar header__bar--3"></span>
      </button>
    </div>
  </div>

  <!-- NAVEGACIÓN OVERLAY MÓVIL (Con el selector de idioma adentro) -->
  <div class="header__mobile-overlay" id="mobileOverlay">
    <nav class="header__mobile-nav" aria-label="Navegación móvil">
      <ul class="header__mobile-list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="header__mobile-link" data-i18n={item.key}>
                {item.labelEs}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Botón / Selector de Idioma dentro del Menú Móvil (Requerimiento 11) -->
      <div class="header__mobile-lang-box">
        <span class="header__mobile-lang-label">Idioma / Language:</span>
        <div class="header__mobile-lang-switch">
          <button
            type="button"
            class="header__lang-option header__lang-option--mobile header__lang-option--active"
            data-lang="es"
          >
            Español
          </button>
          <button
            type="button"
            class="header__lang-option header__lang-option--mobile"
            data-lang="en"
          >
            English
          </button>
        </div>
      </div>

      <a href="/contactanos" class="header__mobile-cta" data-i18n="header.mobileCta">Envíanos un Correo</a>
    </nav>
  </div>
</header>

<style>
  /* Header general con banner en Celeste Shortcut */
  .header {
    --header-nav-height: 72px;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    /* Color inicial: Celeste Shortcut */
    background-color: #1e9cd7;
    color: #ffffff;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
    transition: background-color 0.35s ease, box-shadow 0.35s ease, backdrop-filter 0.35s ease;
  }

  /* Efecto scroll: cuando se scrollea, se aclara */
  .header--scrolled {
    background-color: rgba(225, 243, 255, 0.94);
    backdrop-filter: blur(12px);
    color: #0a2540;
    box-shadow: 0 10px 28px rgba(3, 40, 70, 0.12);
  }

  /* Banner de Aviso Superior */
  .header__top-banner {
    width: 100%;
    background: rgba(0, 75, 128, 0.22);
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    padding: 6px 16px;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.3px;
    text-align: center;
    color: #ffffff;
    transition: all 0.3s ease;
  }

  .header--scrolled .header__top-banner {
    display: none; /* Oculta la barra de aviso al scrollear para dar ligereza */
  }

  .header__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1200px;
    height: var(--header-nav-height);
    margin: 0 auto;
    padding: 0 24px;
    transition: height 0.3s ease;
  }

  .header--scrolled .header__container {
    height: 64px;
  }

  /* LOGO */
  .header__logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    z-index: 1010;
  }

  .header__logo-img {
    width: auto;
    height: 40px;
    max-width: 165px;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .header__logo-link:hover .header__logo-img {
    transform: translateY(-2px);
  }

  /* NAVEGACIÓN ESCRITORIO */
  .header__nav {
    display: flex;
    align-items: center;
  }

  .header__nav-list {
    display: flex;
    align-items: center;
    gap: 2.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__nav-link {
    font-weight: 600;
    font-size: 1rem;
    color: #ffffff;
    text-decoration: none;
    padding: 0.5rem 0;
    position: relative;
    transition: color 0.3s ease;
  }

  .header--scrolled .header__nav-link {
    color: #0a2540;
  }

  .header__nav-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2.5px;
    background-color: #ffffff;
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .header--scrolled .header__nav-link::after {
    background-color: #1e9cd7;
  }

  .header__nav-link:hover {
    color: #e0f4ff;
  }

  .header--scrolled .header__nav-link:hover {
    color: #1e9cd7;
  }

  .header__nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* ACCIONES */
  .header__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    z-index: 1010;
  }

  /* SELECTOR DE IDIOMA ESCRITORIO */
  .header__lang-selector {
    position: relative;
  }

  .header__lang-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-color: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 50px;
    padding: 0.5rem 1rem;
    font-weight: 600;
    font-size: 0.875rem;
    color: #ffffff;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .header--scrolled .header__lang-btn {
    background-color: rgba(10, 37, 64, 0.08);
    border-color: rgba(10, 37, 64, 0.15);
    color: #0a2540;
  }

  .header__lang-btn:hover {
    background-color: rgba(255, 255, 255, 0.35);
  }

  .header--scrolled .header__lang-btn:hover {
    background-color: rgba(10, 37, 64, 0.14);
  }

  .header__icon-globe {
    width: 16px;
    height: 16px;
  }

  .header__icon-chevron {
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }

  .header__lang-selector--active .header__icon-chevron {
    transform: rotate(180deg);
  }

  /* DROPDOWN IDIOMA */
  .header__lang-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    background-color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 12px;
    padding: 0.5rem;
    min-width: 130px;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: all 0.2s ease;
  }

  .header__lang-selector--active .header__lang-dropdown {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .header__lang-option {
    border: none;
    background: transparent;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 6px;
    color: #333333;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .header__lang-option:hover {
    background-color: rgba(30, 156, 215, 0.12);
    color: #1e9cd7;
  }

  .header__lang-option--active {
    background-color: #1e9cd7 !important;
    color: #ffffff !important;
  }

  /* MENÚ HAMBURGUESA */
  .header__menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 26px;
    height: 20px;
    cursor: pointer;
    background: transparent;
    border: none;
    padding: 0;
    color: inherit;
    z-index: 1010;
  }

  .header__bar {
    width: 100%;
    height: 2.5px;
    background-color: currentColor;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease, background-color 0.3s ease;
  }

  .header__menu-toggle--active .header__bar--1 {
    transform: translateY(8.5px) rotate(45deg);
    background-color: #0a2540;
  }

  .header__menu-toggle--active .header__bar--2 {
    opacity: 0;
  }

  .header__menu-toggle--active .header__bar--3 {
    transform: translateY(-9px) rotate(-45deg);
    background-color: #0a2540;
  }

  /* NAVEGACIÓN OVERLAY MÓVIL */
  .header__mobile-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    z-index: 999;
  }

  .header__mobile-overlay--active {
    opacity: 1;
    visibility: visible;
  }

  .header__mobile-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    text-align: center;
    width: 100%;
    padding: 2rem 1.5rem;
  }

  .header__mobile-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .header__mobile-link {
    font-weight: 700;
    font-size: 1.5rem;
    color: #0a2540;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .header__mobile-link:hover {
    color: #1e9cd7;
  }

  /* CAJA DE IDIOMA EN MENÚ MÓVIL (Requerimiento 11) */
  .header__mobile-lang-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 0;
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
    width: min(100%, 260px);
  }

  .header__mobile-lang-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .header__mobile-lang-switch {
    display: flex;
    gap: 8px;
    background: #f1f5f9;
    padding: 4px;
    border-radius: 50px;
  }

  .header__lang-option--mobile {
    padding: 8px 18px;
    border-radius: 50px;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .header__mobile-cta {
    display: inline-block;
    width: 100%;
    max-width: 280px;
    padding: 14px 24px;
    background-color: #1e9cd7;
    color: #ffffff;
    font-weight: 700;
    border-radius: 50px;
    text-decoration: none;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .header__mobile-cta:hover {
    background-color: #1681b3;
    transform: translateY(-2px);
  }

  /* MEDIA QUERIES (MÓVIL < 991px) */
  @media (max-width: 991px) {
    .header__nav {
      display: none;
    }

    /* Ocultar el selector de idioma de la barra superior en móvil */
    .header__lang-selector--desktop {
      display: none !important;
    }

    .header__menu-toggle {
      display: flex;
    }
  }
</style>

<script>
  function setupHeader() {
    const header = document.getElementById("mainHeader");
    const menuToggle = document.getElementById("menuToggle");
    const mobileOverlay = document.getElementById("mobileOverlay");
    const langBtnDesktop = document.getElementById("langBtnDesktop");
    const langSelectorDesktop = document.getElementById("langSelectorDesktop");
    const langOptions = document.querySelectorAll(".header__lang-option");
    const mobileLinks = document.querySelectorAll(".header__mobile-link");

    if (!header) return;

    // 1. Efecto Scroll: cuando se scrollea, se aclara
    const handleScroll = () => {
      if (window.scrollY > 25) {
        header.classList.add("header--scrolled");
      } else {
        header.classList.remove("header--scrolled");
      }
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();

    // 2. Control del Menú Móvil
    if (menuToggle && mobileOverlay) {
      const toggleMenu = (isOpen?: boolean) => {
        const active = isOpen ?? !menuToggle.classList.contains("header__menu-toggle--active");
        menuToggle.classList.toggle("header__menu-toggle--active", active);
        mobileOverlay.classList.toggle("header__mobile-overlay--active", active);
        menuToggle.setAttribute("aria-expanded", String(active));
        document.body.style.overflow = active ? "hidden" : "";
      };

      menuToggle.addEventListener("click", () => toggleMenu());

      mobileLinks.forEach((link) => {
        link.addEventListener("click", () => toggleMenu(false));
      });

      window.addEventListener("resize", () => {
        if (window.innerWidth > 991 && mobileOverlay.classList.contains("header__mobile-overlay--active")) {
          toggleMenu(false);
        }
      });
    }

    // 3. Dropdown Idioma Escritorio
    if (langBtnDesktop && langSelectorDesktop) {
      langBtnDesktop.addEventListener("click", (e) => {
        e.stopPropagation();
        const active = langSelectorDesktop.classList.toggle("header__lang-selector--active");
        langBtnDesktop.setAttribute("aria-expanded", String(active));
      });

      document.addEventListener("click", (e) => {
        if (!langSelectorDesktop.contains(e.target as Node)) {
          langSelectorDesktop.classList.remove("header__lang-selector--active");
          langBtnDesktop.setAttribute("aria-expanded", "false");
        }
      });
    }

    // 4. Selección de Idioma (tanto en Desktop como en Menú Móvil)
    langOptions.forEach((option) => {
      option.addEventListener("click", (e) => {
        e.preventDefault();
        const selectedLang = option.getAttribute("data-lang") || "es";
        
        if (typeof (window as any).setShortcutLanguage === "function") {
          (window as any).setShortcutLanguage(selectedLang);
        }

        if (langSelectorDesktop) {
          langSelectorDesktop.classList.remove("header__lang-selector--active");
          if (langBtnDesktop) langBtnDesktop.setAttribute("aria-expanded", "false");
        }
      });
    });
  }

  document.addEventListener("DOMContentLoaded", setupHeader);
  document.addEventListener("astro:page-load", setupHeader);
</script>