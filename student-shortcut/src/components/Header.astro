---
// src/components/Header.astro

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  logoSrc?: string;
}

const { logoSrc = "/img/SVG/StudentShortcut-LogoBlack_V2.svg" } = Astro.props;

const navItems: NavItem[] = [
  { label: "Programas", href: "/programas" },
  { label: "Nosotros", href: "/quienes-somos" },
  { label: "Intercambio", href: "/irse-intercambio" },
  { label: "Contacto", href: "/contactanos" },
];
---

<header class="header" id="mainHeader">
  <div class="header__container">
    <!-- LOGO -->
    <a href="/" class="header__logo-link" id="headerLogo" aria-label="Ir al inicio">
      <img
        src={logoSrc}
        alt="Student Shortcut Logo"
        class="header__logo-img"
        width="160"
        height="42"
        fetchpriority="high"
        decoding="sync"
      />
    </a>

    <!-- NAVEGACIÓN ESCRITORIO -->
    <nav class="header__nav" aria-label="Navegación principal">
      <ul class="header__nav-list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="header__nav-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- ACCIONES (SELECTOR DE IDIOMA Y MENÚ MÓVIL) -->
    <div class="header__actions">
      <!-- Selector de Idioma -->
      <div class="header__lang-selector" id="langSelector">
        <button
          class="header__lang-btn"
          id="langBtn"
          aria-label="Cambiar idioma"
          aria-haspopup="true"
          aria-expanded="false"
          type="button"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="header__icon-globe"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path
              d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
            ></path>
          </svg>
          <span class="header__lang-text">Español</span>
          <svg
            class="header__icon-chevron"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <div class="header__lang-dropdown" id="langDropdown">
          <a href="#" class="header__lang-option header__lang-option--active" data-lang="es">Español</a>
          <a href="#" class="header__lang-option" data-lang="en">English</a>
        </div>
      </div>

      <!-- Botón Menú Hamburguesa Móvil -->
      <button
        class="header__menu-toggle"
        id="menuToggle"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        type="button"
      >
        <span class="header__bar header__bar--1"></span>
        <span class="header__bar header__bar--2"></span>
        <span class="header__bar header__bar--3"></span>
      </button>
    </div>
  </div>

  <!-- NAVEGACIÓN OVERLAY MÓVIL -->
  <div class="header__mobile-overlay" id="mobileOverlay">
    <nav class="header__mobile-nav" aria-label="Navegación móvil">
      <ul class="header__mobile-list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="header__mobile-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/contactanos" class="header__mobile-cta">Envíanos un Correo</a>
    </nav>
  </div>
</header>

<style>
  /* Variables locales y estructura general */
  .header {
    --header-height: 75px;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--header-height);
    background-color: var(--navbar-bg, #ffffff);
    color: var(--navbar-text, #121212);
    display: flex;
    align-items: center;
    z-index: 1000;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    border-bottom: 1px solid rgba(10, 37, 64, 0.08);
    transition: background-color 0.3s ease, box-shadow 0.3s ease, height 0.3s ease;
  }

  .header--scrolled {
    --header-height: 65px;
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px rgba(10, 37, 64, 0.1);
  }

  .header__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* LOGO (Ajustado) */
  .header__logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    z-index: 1010;
    height: 100%;
  }

  .header__logo-img {
    width: auto;
    height: 42px;
    max-width: 160px;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .header__logo-link:hover .header__logo-img {
    transform: translateY(-2px);
  }

  /* NAVEGACIÓN ESCRITORIO */
  .header__nav {
    display: flex;
    align-items: center;
  }

  .header__nav-list {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__nav-link {
    font-weight: 600;
    font-size: 1rem;
    color: inherit;
    text-decoration: none;
    padding: 0.5rem 0;
    position: relative;
    transition: color 0.3s ease;
  }

  .header__nav-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2.5px;
    background-color: var(--color-primary, #09c6ff);
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .header__nav-link:hover {
    color: var(--color-primary, #09c6ff);
  }

  .header__nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* ACCIONES */
  .header__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    z-index: 1010;
  }

  /* SELECTOR DE IDIOMA */
  .header__lang-selector {
    position: relative;
  }

  .header__lang-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-color: rgba(10, 37, 64, 0.05);
    border: 1px solid rgba(10, 37, 64, 0.1);
    border-radius: 50px;
    padding: 0.5rem 1rem;
    font-weight: 600;
    font-size: 0.875rem;
    color: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .header__lang-btn:hover {
    background-color: rgba(10, 37, 64, 0.1);
  }

  .header__icon-globe {
    width: 16px;
    height: 16px;
    opacity: 0.8;
  }

  .header__icon-chevron {
    width: 14px;
    height: 14px;
    opacity: 0.7;
    transition: transform 0.2s ease;
  }

  .header__lang-selector--active .header__icon-chevron {
    transform: rotate(180deg);
  }

  /* DROPDOWN IDIOMA */
  .header__lang-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    background-color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 12px;
    padding: 0.5rem;
    min-width: 130px;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: all 0.2s ease;
  }

  .header__lang-selector--active .header__lang-dropdown {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .header__lang-option {
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 6px;
    color: #333333;
    text-decoration: none;
    text-align: left;
    transition: background-color 0.2s ease;
  }

  .header__lang-option:hover {
    background-color: rgba(9, 198, 255, 0.1);
    color: var(--color-primary, #09c6ff);
  }

  .header__lang-option--active {
    background-color: var(--color-primary, #09c6ff);
    color: #ffffff !important;
  }

  /* MENÚ HAMBURGUESA */
  .header__menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 18px;
    cursor: pointer;
    background: transparent;
    border: none;
    padding: 0;
    z-index: 1010;
  }

  .header__bar {
    width: 100%;
    height: 2.5px;
    background-color: currentColor;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .header__menu-toggle--active .header__bar--1 {
    transform: translateY(7.5px) rotate(45deg);
  }

  .header__menu-toggle--active .header__bar--2 {
    opacity: 0;
  }

  .header__menu-toggle--active .header__bar--3 {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* NAVEGACIÓN OVERLAY MÓVIL */
  .header__mobile-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    z-index: 999;
  }

  .header__mobile-overlay--active {
    opacity: 1;
    visibility: visible;
  }

  .header__mobile-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    text-align: center;
    width: 100%;
    padding: 2rem;
  }

  .header__mobile-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .header__mobile-link {
    font-weight: 700;
    font-size: 1.5rem;
    color: #121212;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .header__mobile-link:hover {
    color: var(--color-primary, #09c6ff);
  }

  .header__mobile-cta {
    display: inline-block;
    width: 100%;
    max-width: 280px;
    padding: 12px 24px;
    background-color: var(--color-primary, #09c6ff);
    color: #ffffff;
    font-weight: 600;
    border-radius: 50px;
    text-decoration: none;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .header__mobile-cta:hover {
    background-color: #05a0d1;
    transform: translateY(-2px);
  }

  /* MEDIA QUERIES */
  @media (max-width: 991px) {
    .header__nav {
      display: none;
    }

    .header__menu-toggle {
      display: flex;
    }
  }
</style>

<script>
  function setupHeader() {
    const header = document.getElementById("mainHeader");
    const menuToggle = document.getElementById("menuToggle");
    const mobileOverlay = document.getElementById("mobileOverlay");
    const langBtn = document.getElementById("langBtn");
    const langSelector = document.getElementById("langSelector");
    const langOptions = document.querySelectorAll(".header__lang-option");
    const mobileLinks = document.querySelectorAll(".header__mobile-link");

    if (!header) return;

    // 1. Efecto Scroll para reducir altura del Header
    const handleScroll = () => {
      if (window.scrollY > 30) {
        header.classList.add("header--scrolled");
      } else {
        header.classList.remove("header--scrolled");
      }
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();

    // 2. Control del Menú Móvil
    if (menuToggle && mobileOverlay) {
      const toggleMenu = (isOpen?: boolean) => {
        const active = isOpen ?? !menuToggle.classList.contains("header__menu-toggle--active");
        menuToggle.classList.toggle("header__menu-toggle--active", active);
        mobileOverlay.classList.toggle("header__mobile-overlay--active", active);
        menuToggle.setAttribute("aria-expanded", String(active));
        document.body.style.overflow = active ? "hidden" : "";
      };

      menuToggle.addEventListener("click", () => toggleMenu());

      mobileLinks.forEach((link) => {
        link.addEventListener("click", () => toggleMenu(false));
      });

      // Resetear scroll del body si se cambia a pantalla grande con menú abierto
      window.addEventListener("resize", () => {
        if (window.innerWidth > 991 && mobileOverlay.classList.contains("header__mobile-overlay--active")) {
          toggleMenu(false);
        }
      });
    }

    // 3. Selector de Idioma Dropdown
    if (langBtn && langSelector) {
      langBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        const active = langSelector.classList.toggle("header__lang-selector--active");
        langBtn.setAttribute("aria-expanded", String(active));
      });

      document.addEventListener("click", (e) => {
        if (!langSelector.contains(e.target as Node)) {
          langSelector.classList.remove("header__lang-selector--active");
          langBtn.setAttribute("aria-expanded", "false");
        }
      });

      langOptions.forEach((option) => {
        option.addEventListener("click", (e) => {
          e.preventDefault();
          langOptions.forEach((opt) => opt.classList.remove("header__lang-option--active"));
          option.classList.add("header__lang-option--active");

          const langTextEl = langBtn.querySelector(".header__lang-text");
          if (langTextEl && option.textContent) {
            langTextEl.textContent = option.textContent;
          }

          langSelector.classList.remove("header__lang-selector--active");
          langBtn.setAttribute("aria-expanded", "false");
        });
      });
    }
  }

  // Compatibilidad con carga inicial y Astro View Transitions
  document.addEventListener("DOMContentLoaded", setupHeader);
  document.addEventListener("astro:page-load", setupHeader);
</script>