---
// Header.astro
---

<header class="main-header" id="mainHeader">
  <div class="container header-container">
    <!-- LOGO -->
    <a href="#" class="logo" id="headerLogo">
      <div class="logo-icon-wrapper">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="logo-icon"
        >
          <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
          <path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5"></path>
        </svg>
      </div>
      <span class="logo-text"
        >Student<span class="logo-highlight">Shortcut</span></span
      >
    </a>

    <!-- NAVIGATION MENU -->
    <nav class="nav-menu" id="navMenu">
      <ul>
        <li><a href="#programas" class="nav-link">Programas</a></li>
        <li><a href="#nosotros" class="nav-link">Nosotros</a></li>
        <li><a href="#intercambio" class="nav-link">Intercambio</a></li>
        <li><a href="#contacto" class="nav-link">Contacto</a></li>
      </ul>
    </nav>

    <!-- ACTIONS (LANGUAGE & CTA & MOBILE TOGGLE) -->
    <div class="actions">
      <!-- Language Selector -->
      <div class="lang-selector" id="langSelector">
        <button
          class="lang-btn"
          id="langBtn"
          aria-label="Cambiar idioma"
          aria-haspopup="true"
          aria-expanded="false"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="globe-icon"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path
              d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
            ></path>
          </svg>
          <span class="lang-text">Español</span>
          <svg
            class="chevron-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="lang-dropdown" id="langDropdown">
          <a href="#" class="lang-option active" data-lang="es">Español</a>
          <a href="#" class="lang-option" data-lang="en">English</a>
        </div>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <button
        class="menu-toggle"
        id="menuToggle"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <span class="bar bar-1"></span>
        <span class="bar bar-2"></span>
        <span class="bar bar-3"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Overlay -->
  <div class="mobile-overlay" id="mobileOverlay">
    <nav class="mobile-nav">
      <ul>
        <li><a href="#programas" class="mobile-nav-link">Programas</a></li>
        <li><a href="#nosotros" class="mobile-nav-link">Nosotros</a></li>
        <li><a href="#intercambio" class="mobile-nav-link">Intercambio</a></li>
        <li><a href="#contacto" class="mobile-nav-link">Contacto</a></li>
      </ul>
      <a href="#contacto" class="btn mobile-cta-btn">Asesoría Gratis</a>
    </nav>
  </div>
</header>

<style>
  .main-header {
    --header-height: 55px;
    background-color: var(--navbar-bg);
    color: var(--navbar-text);
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--header-height);
    display: flex;
    align-items: center;
    z-index: 1000;
    box-shadow: 0 4px 30px rgba(188, 223, 248, 0.25);
    border-bottom: 1px solid rgba(10, 37, 64, 0.08);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Scrolled style for shrink effect */
  .main-header.scrolled {
    --header-height: 55px;
    background-color: rgba(188, 223, 248, 0.95);
    backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px rgba(10, 37, 64, 0.08);
  }

  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  /* Logo */
  .logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    z-index: 1010;
  }

  .logo-icon-wrapper {
    background-color: var(--color-brand-dark);
    color: var(--color-brand-light);
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-normal);
  }

  .logo:hover .logo-icon-wrapper {
    transform: rotate(-8deg) scale(1.05);
  }

  .logo-icon {
    width: 22px;
    height: 22px;
  }

  .logo-text {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: 1.35rem;
    color: var(--color-brand-dark);
    letter-spacing: -0.025em;
  }

  .logo-highlight {
    color: var(--color-primary);
    font-weight: 800;
  }

  /* Navigation Links */
  .nav-menu {
    display: flex;
    align-items: center;
  }

  .nav-menu ul {
    display: flex;
    gap: 3rem;
  }

  .nav-link {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    color: var(--navbar-text);
    padding: 0.5rem 0;
    position: relative;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2.5px;
    background-color: var(--color-primary);
    border-radius: var(--radius-full);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-link:hover {
    color: var(--color-primary);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* Actions Area */
  .actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    z-index: 1010;
  }

  /* Language Selector */
  .lang-selector {
    position: relative;
  }

  .lang-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-color: rgba(10, 37, 64, 0.05);
    border: 1px solid rgba(10, 37, 64, 0.1);
    border-radius: var(--radius-full);
    padding: 0.5rem 1rem;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--navbar-text);
    transition: all var(--transition-fast);
  }

  .lang-btn:hover {
    background-color: rgba(10, 37, 64, 0.1);
    border-color: rgba(10, 37, 64, 0.2);
  }

  .globe-icon {
    width: 16px;
    height: 16px;
    opacity: 0.8;
  }

  .chevron-icon {
    width: 14px;
    height: 14px;
    opacity: 0.7;
    transition: transform var(--transition-fast);
  }

  .lang-selector.active .chevron-icon {
    transform: rotate(180deg);
  }

  .lang-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 0.5rem;
    min-width: 130px;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    box-shadow: var(--shadow-lg);
    opacity: 0;
    transform: translateY(-10px);
    pointer-events: none;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .lang-selector.active .lang-dropdown {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .lang-option {
    padding: 0.5rem 0.75rem;
    font-size: 0.9rem;
    font-weight: 500;
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    text-align: left;
    transition: background-color var(--transition-fast);
  }

  .lang-option:hover {
    background-color: rgba(188, 223, 248, 0.3);
    color: var(--color-primary);
  }

  .lang-option.active {
    background-color: var(--color-primary);
    color: #ffffff;
  }

  /* CTA Button */
  .btn-navbar-cta {
    background-color: var(--color-brand-dark);
    color: #ffffff;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.625rem 1.25rem;
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-normal);
  }

  .btn-navbar-cta:hover {
    background-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  /* Mobile menu button */
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 18px;
    cursor: pointer;
    background: transparent;
    border: none;
    z-index: 1010;
  }

  .menu-toggle .bar {
    width: 100%;
    height: 2.5px;
    background-color: var(--color-brand-dark);
    border-radius: var(--radius-full);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Hamburger transform when menu is active */
  .menu-toggle.active .bar-1 {
    transform: translateY(7.5px) rotate(45deg);
  }

  .menu-toggle.active .bar-2 {
    opacity: 0;
    transform: translateX(10px);
  }

  .menu-toggle.active .bar-3 {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* Mobile Navigation Overlay */
  .mobile-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: var(--bg-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 999;
  }

  .mobile-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    text-align: center;
    width: 100%;
    padding: 2rem;
  }

  .mobile-nav ul {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .mobile-nav-link {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .mobile-nav-link:hover {
    color: var(--color-primary);
  }

  .mobile-cta-btn {
    width: 100%;
    max-width: 280px;
    font-size: 1.1rem;
    margin-top: 1rem;
  }

  /* Media Queries */
  @media (max-width: 991px) {
    .nav-menu {
      display: none;
    }

    .btn-navbar-cta {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }
  }
</style>

<script>
  // DOM element selections wrapped safely to avoid server-side build issues
  document.addEventListener("astro:page-load", () => {
    setupHeader();
  });

  // Also run on initial load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupHeader);
  } else {
    setupHeader();
  }

  function setupHeader() {
    const header = document.getElementById("mainHeader");
    const menuToggle = document.getElementById("menuToggle");
    const mobileOverlay = document.getElementById("mobileOverlay");
    const langBtn = document.getElementById("langBtn");
    const langSelector = document.getElementById("langSelector");
    const langOptions = document.querySelectorAll(".lang-option");
    const mobileLinks = document.querySelectorAll(".mobile-nav-link");

    if (!header) return; // Prevent double execution errors

    // 1. Scroll Event to Shrink Header
    const handleScroll = () => {
      if (window.scrollY > 30) {
        header.classList.add("scrolled");
      } else {
        header.classList.remove("scrolled");
      }
    };
    window.addEventListener("scroll", handleScroll);
    handleScroll(); // Check initially

    // 2. Mobile Menu Toggle
    if (menuToggle && mobileOverlay) {
      menuToggle.addEventListener("click", () => {
        const isActive = menuToggle.classList.toggle("active");
        mobileOverlay.classList.toggle("active");
        menuToggle.setAttribute("aria-expanded", String(isActive));

        // Prevent background scrolling when menu is open
        if (isActive) {
          document.body.style.overflow = "hidden";
        } else {
          document.body.style.overflow = "";
        }
      });

      // Close mobile menu on link click
      mobileLinks.forEach((link) => {
        link.addEventListener("click", () => {
          menuToggle.classList.remove("active");
          mobileOverlay.classList.remove("active");
          menuToggle.setAttribute("aria-expanded", "false");
          document.body.style.overflow = "";
        });
      });
    }

    // 3. Language Dropdown Toggle
    if (langBtn && langSelector) {
      langBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        const isActive = langSelector.classList.toggle("active");
        langBtn.setAttribute("aria-expanded", String(isActive));
      });

      // Close language selector when clicking outside
      document.addEventListener("click", (e) => {
        if (!langSelector.contains(e.target as Node)) {
          langSelector.classList.remove("active");
          langBtn.setAttribute("aria-expanded", "false");
        }
      });

      // Language option selection logic
      langOptions.forEach((option) => {
        option.addEventListener("click", (e) => {
          e.preventDefault();
          langOptions.forEach((opt) => opt.classList.remove("active"));
          option.classList.add("active");

          const selectedLang = option.getAttribute("data-lang");
          const langTextEl = langBtn.querySelector(".lang-text");

          if (langTextEl) {
            langTextEl.textContent = option.textContent;
          }

          langSelector.classList.remove("active");
          langBtn.setAttribute("aria-expanded", "false");

          // Here, you would trigger translation logic or routing (e.g., /en/)
          console.log(`Language changed to: ${selectedLang}`);
        });
      });
    }
  }
</script>
