---
// Programa 1 Layout
---

<section class="pg-1">
    <div class="ly-pg-1">
        <div class="video-box box-1">
            <video autoplay loop muted playsinline class="pg-video">
                <source src="/media/#" type="video/mp4" />
            </video>
        </div>
        <div class="video-box box-2">
            <video autoplay loop muted playsinline class="pg-video">
                <source src="/media/#" type="video/mp4" />
            </video>
        </div>
        <div class="video-box box-3">
            <video autoplay loop muted playsinline class="pg-video">
                <source src="/media/#" type="video/mp4" />
            </video>
        </div>
        <div class="video-box box-4">
            <video autoplay loop muted playsinline class="pg-video">
                <source src="/media/#" type="video/mp4" />
            </video>
        </div>
    </div>

    <div class="text-pg">
        <h2>Full Year Program</h2>

        <p>
            Diseñado para quienes quieren vivir la experiencia escolar al 100%
        </p>

        <p>
            Durante 8 meses, de agosto a febrero, este programa te sumerge de
            lleno en el corazón de una cultura extranjera dándote el tiempo
            necesario, permitiéndote no solo vivir como un local, sino
            consolidar un rendimiento académico de nivel internacional que
            impulsará tu futuro.
        </p>

        <button>Conocer los requisitos</button>
    </div>
</section>

<style>
    .pg-1 {
        display: grid;
        /* auto para el mosaico de videos, 1fr para que el texto ocupe el resto */
        grid-template-columns: auto 1fr;
        gap: 32px;
        width: 100%; /* Cambiado a 100% para que respete al carrusel */
        max-width: 1200px;
        margin: 0 auto;
        align-items: center; /* Centra verticalmente videos y texto */
    }
    .text-pg{
        display: flex;
        flex-direction: column;
        gap: 25px;
    }
    .text-pg h2{
        color: #fff;
        font-size: 40px;

    }
    .text-pg p{
        color: #fff;
        font-size: 20px;
    }
    .text-pg button{
        color: white;
        border: white 1px solid;
        padding: 11px;
        max-width: 300px;
        border-radius: 15px;
    }

    /* ly-pg-1 significa layout de programa 1 / es el template para los videos  */
    .ly-pg-1 {
        display: grid;
        grid-template-columns: 261px 160px;
        grid-template-rows: 160px 88px 88px;
        gap: 13px 27px;
        width: fit-content;
    }

    .video-box {
        border-radius: 16px;
        overflow: hidden;
        background-color: #000;
    }

    .pg-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* --- Posicionamiento Grid Mosaico --- */
    .box-1 {
        grid-column: 1;
        grid-row: 1 / span 2;
    }
    .box-2 {
        grid-column: 2;
        grid-row: 1;
    }
    .box-3 {
        grid-column: 2;
        grid-row: 2;
    }
    .box-4 {
        grid-column: 1 / span 2;
        grid-row: 3;
    }

    /* --- RESPONSIVE DESIGN --- */

    /* Pantallas medianas (Tablets) */
    @media (max-width: 1300px) {
        .pg-1 {
            gap: 20px;
        }
        .ly-pg-1 {
            grid-template-columns: 200px 113px;
            grid-template-rows: 113px 64px 64px;
            gap: 10px 20px;
        }
    }

    /* Pantallas pequeñas (Móviles) */
    @media (max-width: 850px) {
        .pg-1 {
            /* Apilamos verticalmente: videos arriba, texto abajo */
            grid-template-columns: 1fr;
            justify-items: center; /* Centramos el mosaico */
            text-align: center; /* Centramos el texto */
            gap: 24px;
            padding: 0 15px; /* Margen lateral de seguridad */
        }
    }

    /* Pantallas MUY pequeñas (Móviles pequeños) */
    @media (max-width: 400px) {
        .ly-pg-1 {
            /* Achicamos el mosaico proporcionalmente para que no se salga de la pantalla */
            grid-template-columns: 160px 90px;
            grid-template-rows: 90px 50px 50px;
            gap: 8px 15px;
        }
    }
</style>
