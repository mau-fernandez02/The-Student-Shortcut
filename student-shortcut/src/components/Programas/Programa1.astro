---
// src/components/Programas/Programa1.astro

interface Props {
  title?: string;
  tagline?: string;
  description?: string;
  buttonText?: string;
  buttonLink?: string;
}

const {
  title = "Full Year Program",
  tagline = "Diseñado para quienes quieren vivir la experiencia escolar al 100%",
  description = "Durante 8 meses, de agosto a febrero, este programa te sumerge de lleno en el corazón de una cultura extranjera dándote el tiempo necesario, permitiéndote no solo vivir como un local, sino consolidar un rendimiento académico de nivel internacional que impulsará tu futuro.",
  buttonText = "¡Aplica ya!",
  buttonLink = "/formulario",
} = Astro.props;
---

<section class="program-card">
  <!-- Mosaico de Vídeos (Desktop y Móvil) -->
  <div class="program-card__mosaic">
    <!-- Video A -->
    <div class="program-card__box program-card__box--box-1">
      <video autoplay loop muted playsinline class="program-card__video">
        <source src="/media/Mobile/VideoA-Programas-Mobile.mp4" media="(max-width: 768px)" type="video/mp4" />
        <source src="/media/VideoA-Programas-FullYear.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- Video B -->
    <div class="program-card__box program-card__box--box-2">
      <video autoplay loop muted playsinline class="program-card__video">
        <source src="/media/Mobile/VideoB-Programas-Mobile.mp4" media="(max-width: 768px)" type="video/mp4" />
        <source src="/media/VideoB-Programas-FullYear.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- Video C -->
    <div class="program-card__box program-card__box--box-3">
      <video autoplay loop muted playsinline class="program-card__video">
        <source src="/media/Mobile/VideoC-Programas-Mobile.mp4" media="(max-width: 768px)" type="video/mp4" />
        <source src="/media/VideoC-Programas-FullYear.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- Video D -->
    <div class="program-card__box program-card__box--box-4">
      <video autoplay loop muted playsinline class="program-card__video">
        <source src="/media/Mobile/VideoD-Programas-Mobile.mp4" media="(max-width: 768px)" type="video/mp4" />
        <source src="/media/VideoD-Programas-FullYear.mp4" type="video/mp4" />
      </video>
    </div>
  </div>

  <!-- Contenido Informativo -->
  <div class="program-card__content">
    <h2 class="program-card__title" data-i18n="programs.fullYear.title">{title}</h2>
    <p class="program-card__tagline" data-i18n="programs.fullYear.tagline">{tagline}</p>
    <p class="program-card__description" data-i18n="programs.fullYear.desc">{description}</p>

    <!-- Botón Interactivo ¡Aplica ya! (Requerimiento 8) -->
    <a href={buttonLink} class="program-card__btn" data-i18n="programs.fullYear.btn">
      {buttonText}
    </a>
  </div>
</section>

<style>
  .program-card {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 3.5rem;
    width: 100%;
    margin: 0 auto;
    align-items: center;
  }

  .program-card__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    color: #ffffff;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .program-card__title {
    color: #ffffff;
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    font-weight: 800;
    margin: 0;
  }

  .program-card__tagline {
    color: #ffffff;
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    font-weight: 600;
    line-height: 1.4;
    margin: 0;
  }

  .program-card__description {
    color: rgba(255, 255, 255, 0.95);
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    line-height: 1.65;
    margin: 0;
  }

  /* Botón ¡Aplica ya! */
  .program-card__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    background-color: transparent;
    border: 2px solid #ffffff;
    padding: 13px 36px;
    max-width: 260px;
    border-radius: 50px;
    text-align: center;
    text-decoration: none;
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    margin-top: 0.5rem;
  }

  .program-card__btn:hover {
    background-color: #ffffff;
    color: #005b97;
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
  }

  /* Mosaico Grid de Videos */
  .program-card__mosaic {
    display: grid;
    grid-template-columns: 261px 160px;
    grid-template-rows: 160px 88px 88px;
    gap: 14px 20px;
    width: 100%;
    max-width: 448px;
  }

  .program-card__box {
    border-radius: 16px;
    overflow: hidden;
    background-color: #000000;
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.25);
    border: none;
  }

  .program-card__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .program-card__box--box-1 {
    grid-column: 1;
    grid-row: 1 / span 2;
  }

  .program-card__box--box-2 {
    grid-column: 2;
    grid-row: 1;
  }

  .program-card__box--box-3 {
    grid-column: 2;
    grid-row: 2;
  }

  .program-card__box--box-4 {
    grid-column: 1 / span 2;
    grid-row: 3;
  }

  /* Responsive Design Móvil (PDF 1 pág 4 - Corrección 7) */
  @media (max-width: 1024px) {
    .program-card {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 2rem;
    }

    .program-card__content {
      align-items: center;
      text-align: center;
      padding: 0 16px;
      box-sizing: border-box;
      width: 100%;
    }

    .program-card__title {
      font-size: clamp(1.8rem, 5vw, 2.4rem);
    }
  }

  @media (max-width: 500px) {
    .program-card__mosaic {
      grid-template-columns: 216px 64px;
      grid-template-rows: 88px 214px;
      gap: 12px;
      max-width: 295px;
    }

    .program-card__box--box-1 {
      grid-column: 1;
      grid-row: 1;
    }

    .program-card__box--box-2 {
      grid-column: 2;
      grid-row: 1;
    }

    .program-card__box--box-3 {
      grid-column: 1;
      grid-row: 2;
    }

    .program-card__box--box-4 {
      grid-column: 2;
      grid-row: 2;
    }

    .program-card__btn {
      width: 100%;
      max-width: 280px;
    }
  }
</style>